{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

{%- liquid
  assign seo_title = ''
  assign seo_description = ''

  if request.page_type == 'index'
    assign seo_title = 'Andromeda Paris — Masques, bandeaux et chouchous en soie de mûrier grade 6A'
    assign seo_description = 'Masques de nuit, bandeaux et chouchous en soie de mûrier grade 6A, 22 mommes. Occultation totale grâce à la densité 22 mommes, hypoallergénique. Livraison offerte dès 65 €.'

  elsif request.page_type == 'product'
    if product.handle == 'masque-de-sommeil-en-soie-de-murier-22-mommes'
      assign seo_title = 'Masque de nuit en soie de mûrier 22 mommes 6A | Andromeda Paris'
      assign seo_description = "Masque de sommeil 100 % soie de mûrier 22 mommes, grade 6A, occultant, sangle ajustable. Livré en coffret cadeau + rituel sonore d'endormissement. Livraison offerte dès 65 €."
    elsif product.handle == 'bandeau-de-sommeil-en-soie-rituel-de-sommeil-inclus'
      assign seo_title = 'Bandeau de nuit en soie de mûrier 22 mommes 6A | Andromeda Paris'
      assign seo_description = "Bandeau de nuit 100 % soie de mûrier 22 mommes, grade 6A, doux pour les cheveux et sans pression. Livré en coffret cadeau + rituel sonore d'endormissement. Livraison offerte dès 65 €."
    elsif product.handle == 'chouchou-pour-cheveux-en-soie-de-murier-22-mommes'
      assign seo_title = 'Chouchous en soie de mûrier 22 mommes 6A | Andromeda Paris'
      assign seo_description = 'Lot de 2 chouchous 100 % soie de mûrier 22 mommes, grade 6A, hypoallergénique, doux pour les cheveux. Packaging premium, livraison offerte dès 65 €.'
    else
      assign seo_title = product.title | append: ' — Andromeda'
      assign seo_description = product.description | strip_html | truncate: 155
    endif

  elsif request.page_type == 'collection'
    assign seo_title = collection.title | append: ' — Andromeda'
    assign seo_description = 'Explorez la collection ' | append: collection.title | append: " d'Andromeda. Accessoires de sommeil haut de gamme en soie de mûrier, pensés pour un rituel du soir élégant."

  elsif request.page_type == 'article'
    assign seo_title = article.title | append: ' — Andromeda'
    assign seo_description = article.excerpt_or_content | strip_html | truncate: 155

  elsif request.page_type == 'blog'
    assign seo_title = 'Blog Sommeil & Bien-être — Andromeda Paris'
    assign seo_description = 'Conseils, rituels et inspirations pour mieux dormir par Andromeda. Soie de mûrier, bien-être nocturne, routines beauté : plongez dans un univers de douceur.'

  elsif request.page_type == 'page'
    if page.handle == 'contact'
      assign seo_title = 'Contactez Andromeda — Service Client & Commandes'
      assign seo_description = 'Une question sur votre commande ou nos masques en soie ? Notre équipe vous répond sous 24h. Contactez Andromeda Paris par email ou formulaire.'
    elsif page.handle == 'faq'
      assign seo_title = 'FAQ — Masque de Sommeil en Soie | Andromeda Paris'
      assign seo_description = 'Toutes vos questions sur le masque Andromeda : soie de mûrier grade 6A, entretien, livraison, retours. Réponses claires et complètes.'
    elsif page.handle == 'rituels'
      assign seo_title = 'Rituels du Soir — Andromeda'
      assign seo_description = ''
      assign seo_noindex = true
    else
      assign seo_title = page.title | append: ' — Andromeda'
      assign seo_description = page.content | strip_html | truncate: 155
    endif

  elsif request.page_type == 'search'
    assign seo_title = 'Recherche — Andromeda Paris'
    assign seo_description = "Trouvez l'accessoire de sommeil idéal parmi la sélection premium Andromeda."

  elsif request.page_type == 'cart'
    assign seo_title = 'Votre Panier — Andromeda Paris'
    assign seo_description = "Finalisez votre commande et offrez-vous un rituel de sommeil d'exception avec Andromeda."

  else
    assign seo_title = page_title | default: shop.name
    assign seo_description = page_description | default: shop.description | default: "Andromeda — Masques de sommeil premium en soie de mûrier grade 6A. Un rituel du soir élégant, doux et sensoriel."
  endif
%}
<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = seo_title | default: page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title | default: page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- if seo_noindex -%}
  <meta name="robots" content="noindex, nofollow">
{%- endif -%}

{%- if request.page_type == 'product' -%}
<meta
  name="description"
  content="{{ seo_description | default: page_description | default: product.description | strip_html | truncate: 160 | escape }}"
>
{%- elsif request.page_type == 'article' -%}
<meta
  name="description"
  content="{{ page_description | default: article.excerpt | strip_html | default: article.content | strip_html | truncate: 160 | escape }}"
>
{%- else -%}
<meta
  name="description"
  content="{{ seo_description | default: page_description | default: shop.description | default: shop.name | escape }}"
>
{%- endif -%}
