{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign price_cents = variant.price
  assign compare_cents = variant.compare_at_price | default: variant.price
-%}

<div
  id="andromeda-bundle-{{ block.id }}"
  class="andromeda-bundle-wrap spacing-style"
  data-block-id="{{ block.id }}"
  data-price="{{ price_cents }}"
  data-compare="{{ compare_cents }}"
  data-discount-qty="{{ block.settings.discount_qty }}"
  data-discount-percent="{{ block.settings.discount_percent }}"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
<div class="andromeda-bundle">
  {%- assign options = block.settings.options | split: ',' -%}

  {%- for opt in options -%}
    {%- assign qty = opt | strip | plus: 0 -%}
    {%- if qty < 1 -%}{%- continue -%}{%- endif -%}

    {%- assign total_price = price_cents | times: qty -%}
    {%- assign total_compare = compare_cents | times: qty -%}
    {%- assign total_compare = total_compare | at_least: total_price -%}

    {%- if block.settings.discount_qty > 0 and qty >= block.settings.discount_qty -%}
      {%- assign total_compare = total_price -%}
      {%- assign discount_multiplier = 100 | minus: block.settings.discount_percent -%}
      {%- assign total_price = total_price | times: discount_multiplier | divided_by: 100.0 | round -%}
    {%- endif -%}

    {%- assign has_free_shipping = false -%}
    {%- if block.settings.shipping_qty == qty -%}
      {%- assign has_free_shipping = true -%}
    {%- endif -%}

    {%- comment -%} Image personnalisée par quantité {%- endcomment -%}
    {%- case qty -%}
      {%- when 1 -%}{%- assign custom_img = block.settings.image_1 -%}
      {%- when 2 -%}{%- assign custom_img = block.settings.image_2 -%}
      {%- when 3 -%}{%- assign custom_img = block.settings.image_3 -%}
      {%- else -%}{%- assign custom_img = blank -%}
    {%- endcase -%}

    <div
      class="ab-card{% if forloop.first %} ab-card--selected{% endif %}{% if block.settings.popular_qty == qty %} ab-card--popular{% endif %}"
      data-qty="{{ qty }}"
      role="button"
      tabindex="0"
    >
      {%- if block.settings.popular_qty == qty -%}
        <div class="ab-card__badge-top">{{ block.settings.popular_label | default: 'Plus populaire' }}</div>
      {%- endif -%}

      <div class="ab-card__header">
        {%- case qty -%}
          {%- when 1 -%}{{ block.settings.label_1 | default: '1 masque' }}
          {%- when 2 -%}{{ block.settings.label_2 | default: '2 masques' }}
          {%- when 3 -%}{{ block.settings.label_3 | default: '3 masques' }}
          {%- else -%}{{ qty }} {{ block.settings.unit_label | default: 'masques' }}
        {%- endcase -%}
      </div>

      <div class="ab-card__image">
        {%- if custom_img != blank -%}
          {{
            custom_img
            | image_url: width: 240
            | image_tag:
              loading: 'lazy',
              alt: product.title,
              class: 'ab-card__img ab-card__img--custom',
              width: 120,
              height: 80
          }}
        {%- else -%}
          {%- assign fallback_img = variant.featured_image | default: product.featured_image -%}
          {%- if fallback_img != blank -%}
            {%- for i in (1..qty) -%}
              {{
                fallback_img
                | image_url: width: 120
                | image_tag:
                  loading: 'lazy',
                  alt: product.title,
                  class: 'ab-card__img',
                  width: 52,
                  height: 52
              }}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="ab-card__prices">
        {%- if total_compare > total_price -%}
          <span class="ab-card__compare">{{ total_compare | money }}</span>
        {%- endif -%}
        <span class="ab-card__price" data-price-display>{{ total_price | money }}</span>
      </div>

      {%- if has_free_shipping -%}
        <div class="ab-card__shipping">{{ block.settings.shipping_label | default: '+ Livraison offerte' }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

</div>

<style>
  .andromeda-bundle-wrap {
    width: 100%;
    margin-top: 16px;
  }

  .andromeda-bundle {
    display: flex;
    gap: 10px;
    width: 100%;
  }

  .ab-card {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 8px 8px;
    border: 2px solid #e0dbd4;
    border-radius: 10px;
    cursor: pointer;
    text-align: center;
    transition: border-color 0.18s;
    background: #fff;
    user-select: none;
  }

  .ab-card:hover {
    border-color: #191a2e;
  }

  .ab-card--selected {
    border-color: #191a2e;
  }

  .ab-card__badge-top {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    background: #191a2e;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }

  .ab-card__header {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1c1a18;
    margin-top: 2px;
  }

  .ab-card__image {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3px;
    min-height: 44px;
    align-items: center;
  }

  .ab-card__img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 4px;
  }

  .ab-card__img--custom {
    width: 100%;
    max-width: 120px;
    height: auto;
    object-fit: contain;
  }

  .ab-card__prices {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
  }

  .ab-card__compare {
    font-size: 11px;
    color: #999;
    text-decoration: line-through;
  }

  .ab-card__price {
    font-size: 15px;
    font-weight: 700;
    color: #1c1a18;
    font-variant-numeric: normal;
    font-feature-settings: normal;
  }

  .ab-card__shipping {
    font-size: 10px;
    font-weight: 700;
    color: #191a2e;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: rgba(25, 26, 46, 0.08);
    border-radius: 4px;
    padding: 3px 8px;
  }



  @media (max-width: 480px) {
    .andromeda-bundle { gap: 8px; }
    .ab-card { padding: 12px 8px 10px; }
    .ab-card__image { min-height: 64px; }
    .ab-card__img { width: 64px; height: 64px; }
    .ab-card__price { font-size: 13px; }
  }

  /* Prix affiché dans le bouton ATC (voir add-to-cart-button.liquid pour le
     markup) — placé ici car le bloc de style d'un snippet rendu à plusieurs
     endroits de la page ne se chargeait pas de façon fiable. */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap');

  @font-face {
    font-family: 'GC Amelie Promised';
    src: url('https://cdn.shopify.com/s/files/1/1000/9375/5727/files/GC_Amelie_Promised.woff2?v=1786960246') format('woff2');
    font-style: normal;
    font-display: swap;
  }

  /* .button defaults to display:grid with a single implicit column, which
     blockifies .atc-bundle-price into its own grid row (stretched full-width,
     left-aligned) instead of sitting inline next to the button text. Force
     flex here so text + price stay on one centered line. */
  .add-to-cart-button:has(.atc-bundle-price) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    row-gap: 2px;
  }

  .atc-bundle-price {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-inline-start: 8px;
    line-height: 1;
    font-variant-numeric: normal;
    font-feature-settings: normal;
    font-family: 'Inter', sans-serif;
  }

  .atc-bundle-price__current {
    font-family: 'GC Amelie Promised', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.15em;
    line-height: 1;
  }

  .atc-bundle-price__compare {
    display: inline-block;
    font-size: 0.7em;
    line-height: 1;
    opacity: 0.55;
  }

  .atc-bundle-price__compare[hidden] {
    display: none;
  }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script>
(function () {
  var bundle = document.getElementById('andromeda-bundle-{{ block.id }}');
  if (!bundle) return;


  function fmt(cents) {
    return (cents / 100).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
  }

  /* Même animation lettre par lettre (fade + slide) que le nom de variante
     dans le sélecteur de couleur, réutilisée ici pour le prix du bouton ATC. */
  function animatePriceText(el, newText) {
    if (!el || el.textContent === newText) return;
    if (!window.gsap) {
      el.textContent = newText;
      return;
    }
    el.textContent = newText;
    var text = el.textContent;
    el.innerHTML = text.split('').map(function (ch) {
      return '<span style="display:inline-block;will-change:transform,opacity">' + (ch === ' ' ? '&nbsp;' : ch) + '</span>';
    }).join('');
    gsap.fromTo(el.querySelectorAll('span'),
      { opacity: 0, y: -6 },
      { opacity: 1, y: 0, duration: 0.18, stagger: 0.025, ease: 'power2.out' }
    );
  }

  function currentQty() {
    var input = getQtyInput();
    if (input) {
      var val = parseInt(input.value, 10);
      if (val > 0) return val;
    }
    var sel = bundle.querySelector('.ab-card--selected');
    return sel ? parseInt(sel.dataset.qty, 10) : 1;
  }

  /* Mirrors the liquid-side discount math so the JS-driven updates (variant
     change, ATC button price) stay consistent with the server-rendered
     cards, which already apply the discount at initial render. */
  function discountedTotal(qty, price) {
    var total = price * qty;
    var discountQty = parseInt(bundle.dataset.discountQty, 10) || 0;
    var discountPercent = parseInt(bundle.dataset.discountPercent, 10) || 0;
    if (discountQty > 0 && qty >= discountQty) {
      total = Math.round((total * (100 - discountPercent)) / 100);
    }
    return total;
  }

  /* ── Totaux ── */
  function updateTotals() {
    var qty     = currentQty();
    var price   = parseInt(bundle.dataset.price, 10);
    var compare = parseInt(bundle.dataset.compare, 10);
    updateAtcPrice(qty, price, compare);
  }

  /* ── Prix dans le bouton ATC ── */
  function updateAtcPrice(qty, price, compare) {
    var wrap = document.querySelector('.atc-bundle-price');
    if (!wrap) return;
    var currentEl = wrap.querySelector('[data-atc-price-current]');
    var compareEl = wrap.querySelector('[data-atc-price-compare]');

    var total = discountedTotal(qty, price);
    var fullTotal = price * qty;
    var compareTotal = Math.max(compare * qty, fullTotal);

    wrap.hidden = false;
    if (currentEl) animatePriceText(currentEl, fmt(total));
    if (compareEl) {
      if (compareTotal > total) {
        animatePriceText(compareEl, fmt(compareTotal));
        compareEl.hidden = false;
      } else {
        compareEl.hidden = true;
      }
    }
  }

  /* Init : retry pour attendre que add-to-cart-component soit prêt */
  updateTotals();
  setTimeout(updateTotals, 300);
  setTimeout(updateTotals, 800);
  window.addEventListener('load', updateTotals);

  /* ── Quantité ── */
  function getQtyInput() {
    var form = document.querySelector('[data-type="add-to-cart-form"]');
    if (!form) return null;
    return form.querySelector('input[name="quantity"], .quantity__input');
  }

  function selectCard(card) {
    bundle.querySelectorAll('.ab-card').forEach(function (c) { c.classList.remove('ab-card--selected'); });
    card.classList.add('ab-card--selected');
    var qty = parseInt(card.dataset.qty, 10);
    var input = getQtyInput();
    if (input) { input.value = qty; input.dispatchEvent(new Event('change', { bubbles: true })); }
    updateTotals();
  }

  bundle.querySelectorAll('.ab-card').forEach(function (card) {
    card.addEventListener('click', function () { selectCard(card); });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCard(card); }
    });
  });

  /* ── Changement de quantité via le sélecteur natif (+/- ou saisie) ── */
  document.addEventListener('quantity-selector:update', function () {
    updateTotals();
  });

  /* ── Changement de variante ── */
  document.addEventListener('variant:change', function (e) {
    if (!e.detail || !e.detail.variant) return;
    var v = e.detail.variant;
    bundle.dataset.price   = v.price;
    bundle.dataset.compare = v.compare_at_price || v.price;

    /* Mise à jour des prix dans chaque carte */
    bundle.querySelectorAll('.ab-card').forEach(function (card) {
      var qty  = parseInt(card.dataset.qty, 10);
      var fullTotal = v.price * qty;
      var tot  = discountedTotal(qty, v.price);
      var comp = Math.max((v.compare_at_price || v.price) * qty, fullTotal);
      if (tot < fullTotal) comp = fullTotal;
      var pEl  = card.querySelector('.ab-card__price');
      var cEl  = card.querySelector('.ab-card__compare');
      if (pEl) pEl.textContent = fmt(tot);
      if (cEl) { if (comp > tot) { cEl.textContent = fmt(comp); cEl.hidden = false; } else { cEl.hidden = true; } }
    });
    updateTotals();
  });
})();
</script>

{% schema %}
{
  "name": "Bundle picker",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "options",
      "label": "Quantités (séparées par des virgules)",
      "default": "1,2",
      "info": "Ex: 1,2,3"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Label quantité 1",
      "default": "1 masque"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Label quantité 2",
      "default": "2 masques"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Label quantité 3",
      "default": "3 masques"
    },
    {
      "type": "text",
      "id": "unit_label",
      "label": "Unité (pour qty > 3)",
      "default": "masques"
    },
    {
      "type": "header",
      "content": "Images personnalisées"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image quantité 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image quantité 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image quantité 3"
    },
    {
      "type": "header",
      "content": "Mise en avant"
    },
    {
      "type": "range",
      "id": "popular_qty",
      "label": "Badge 'Plus populaire' sur la quantité",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2,
      "info": "0 = désactivé"
    },
    {
      "type": "text",
      "id": "popular_label",
      "label": "Texte du badge mise en avant",
      "default": "Plus populaire"
    },
    {
      "type": "header",
      "content": "Réduction quantité"
    },
    {
      "type": "range",
      "id": "discount_qty",
      "label": "Appliquer une réduction à partir de la quantité",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2,
      "info": "0 = désactivé. Doit correspondre à la remise automatique configurée dans Shopify (Réductions) pour que le prix affiché ici corresponde à celui payé au paiement."
    },
    {
      "type": "range",
      "id": "discount_percent",
      "label": "Pourcentage de réduction",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 5,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Livraison offerte"
    },
    {
      "type": "range",
      "id": "shipping_qty",
      "label": "Afficher 'Livraison offerte' sur la quantité",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2,
      "info": "0 = désactivé"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Texte livraison offerte",
      "default": "+ Livraison offerte"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Haut",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bas",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Bundle picker",
      "category": "Produit"
    }
  ]
}
{% endschema %}
