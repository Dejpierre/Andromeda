{%- liquid
  assign story_product = closest.product | default: product
-%}

<div class="product-story" {{ block.shopify_attributes }}>
  <button type="button" class="product-story__trigger product-story__trigger--{{ block.settings.trigger_style | default: 'button' }}" id="product-story-trigger-{{ block.id }}">
    {%- if block.settings.trigger_style == 'bubble' -%}
      <span class="stories-bubble__ring">
        <span class="stories-bubble__ring-inner">
          {%- if block.settings.bubble_image != blank -%}
            {{ block.settings.bubble_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'stories-bubble__image', alt: block.settings.trigger_label }}
          {%- elsif story_product.featured_image != blank -%}
            {{ story_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'stories-bubble__image', alt: block.settings.trigger_label }}
          {%- endif -%}
        </span>
      </span>
      <span class="product-story__trigger-label">{{ block.settings.trigger_label | default: 'Voir en story' }}</span>
    {%- else -%}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="7 4 20 12 7 20 7 4"></polygon></svg>
      <span>{{ block.settings.trigger_label | default: 'Voir en story' }}</span>
    {%- endif -%}
  </button>

  <div class="product-story-slide-data-wrap" hidden>
    {% content_for 'blocks' %}
  </div>
</div>

<div class="stories-viewer__backdrop" id="product-story-backdrop-{{ block.id }}" hidden></div>
<div class="stories-viewer" id="product-story-viewer-{{ block.id }}" hidden>
  <div class="stories-viewer__progress" id="product-story-progress-{{ block.id }}"></div>

  <div class="stories-viewer__header">
    <span class="stories-viewer__title" id="product-story-title-{{ block.id }}">{{ story_product.title }}</span>
    <div class="stories-viewer__header-actions">
      <button type="button" class="stories-viewer__icon-btn" id="product-story-mute-{{ block.id }}" aria-label="Activer le son" aria-pressed="false" hidden>
        <svg class="stories-icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
        <svg class="stories-icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
      </button>
      <button type="button" class="stories-viewer__icon-btn" id="product-story-close-{{ block.id }}" aria-label="Fermer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div class="stories-viewer__media" id="product-story-media-{{ block.id }}"></div>

  <button type="button" class="stories-viewer__replay" id="product-story-replay-{{ block.id }}" hidden>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
    <span>Revoir</span>
  </button>

  <button type="button" class="stories-viewer__tap stories-viewer__tap--prev" id="product-story-tap-prev-{{ block.id }}" aria-label="Précédent"></button>
  <button type="button" class="stories-viewer__tap stories-viewer__tap--next" id="product-story-tap-next-{{ block.id }}" aria-label="Suivant"></button>

  <div class="stories-viewer__heading" id="product-story-heading-{{ block.id }}" hidden></div>

  <div class="stories-viewer__product" id="product-story-product-{{ block.id }}" hidden>
    <div class="stories-viewer__product-scroll" id="product-story-product-scroll-{{ block.id }}"></div>
    <button type="button" class="stories-viewer__product-next" id="product-story-product-next-{{ block.id }}" aria-label="Voir l'autre variante" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</div>

<script>
  (function () {
    var blockId = {{ block.id | json }};

    var productData = {
      title: {{ story_product.title | json }},
      price: {{ story_product.price | money | json }},
      image: {% if story_product.featured_image != blank %}{{ story_product.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %},
      url: {{ story_product.url | json }},
      variantId: {% if story_product.selected_or_first_available_variant != blank %}{{ story_product.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
      available: {% if story_product.selected_or_first_available_variant != blank %}{{ story_product.selected_or_first_available_variant.available | json }}{% else %}false{% endif %},
      variants: [
        {%- if story_product.options_with_values.size == 1 -%}
          {%- for val in story_product.options_with_values.first.values -%}
          {
            id: {% if val.variant %}{{ val.variant.id | json }}{% else %}null{% endif %},
            title: {{ story_product.title | json }},
            label: {{ val.name | json }},
            available: {{ val.available | json }},
            price: {% if val.variant %}{{ val.variant.price | money | json }}{% else %}null{% endif %},
            image: {% if val.variant.featured_image != blank %}{{ val.variant.featured_image | image_url: width: 200 | json }}{% elsif story_product.featured_image != blank %}{{ story_product.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %},
            url: {{ story_product.url | json }}
          }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ]
    };

    var root = document.querySelector('.product-story-slide-data-wrap[hidden]');
    var container = document.getElementById('product-story-trigger-' + blockId).closest('.product-story');
    var dataWrap = container.querySelector('.product-story-slide-data-wrap');
    var slides = Array.prototype.map.call(dataWrap.querySelectorAll('.product-story-slide-data'), function (el) {
      return {
        mediaType: el.dataset.mediaType,
        image: el.dataset.image || null,
        video: el.dataset.video || null,
        videoPoster: el.dataset.videoPoster || null,
        duration: parseInt(el.dataset.duration, 10) || 5,
        heading: el.dataset.heading || ''
      };
    });

    if (!slides.length) return;

    var trigger = document.getElementById('product-story-trigger-' + blockId);
    var viewer = document.getElementById('product-story-viewer-' + blockId);
    var backdrop = document.getElementById('product-story-backdrop-' + blockId);
    var progressEl = document.getElementById('product-story-progress-' + blockId);
    var mediaEl = document.getElementById('product-story-media-' + blockId);
    var headingEl = document.getElementById('product-story-heading-' + blockId);
    var productEl = document.getElementById('product-story-product-' + blockId);
    var productScrollEl = document.getElementById('product-story-product-scroll-' + blockId);
    var productNextBtn = document.getElementById('product-story-product-next-' + blockId);
    var replayBtn = document.getElementById('product-story-replay-' + blockId);
    var closeBtn = document.getElementById('product-story-close-' + blockId);
    var muteBtn = document.getElementById('product-story-mute-' + blockId);
    var tapPrev = document.getElementById('product-story-tap-prev-' + blockId);
    var tapNext = document.getElementById('product-story-tap-next-' + blockId);

    var currentSlideIndex = 0;
    var currentVideoEl = null;
    var progressTimer = null;
    var isMuted = true;
    var isPaused = false;

    function cartUrl(path) {
      var shopRoot = window.Shopify && window.Shopify.routes && window.Shopify.routes.root;
      return (shopRoot || '/') + path;
    }

    function buildProgressBars(count) {
      progressEl.innerHTML = '';
      for (var i = 0; i < count; i++) {
        var seg = document.createElement('span');
        seg.className = 'stories-viewer__progress-seg';
        var fill = document.createElement('span');
        fill.className = 'stories-viewer__progress-fill';
        seg.appendChild(fill);
        progressEl.appendChild(seg);
      }
    }

    function setProgressState(index, state) {
      var segs = progressEl.querySelectorAll('.stories-viewer__progress-seg');
      var seg = segs[index];
      if (!seg) return;
      var fill = seg.querySelector('.stories-viewer__progress-fill');
      if (state === 'done') {
        fill.style.transition = 'none';
        fill.style.width = '100%';
      } else if (state === 'reset') {
        fill.style.transition = 'none';
        fill.style.width = '0%';
      }
    }

    function animateProgress(index, durationMs) {
      var segs = progressEl.querySelectorAll('.stories-viewer__progress-seg');
      var seg = segs[index];
      if (!seg) return;
      var fill = seg.querySelector('.stories-viewer__progress-fill');
      fill.style.transition = 'none';
      fill.style.width = '0%';
      // eslint-disable-next-line no-unused-expressions
      fill.offsetHeight;
      fill.style.transition = 'width ' + durationMs + 'ms linear';
      fill.style.width = '100%';
    }

    function clearAutoAdvance() {
      if (progressTimer) {
        clearTimeout(progressTimer);
        progressTimer = null;
      }
    }

    function stopCurrentMedia() {
      clearAutoAdvance();
      if (currentVideoEl) {
        currentVideoEl.pause();
        currentVideoEl = null;
      }
      mediaEl.innerHTML = '';
      replayBtn.hidden = true;
    }

    function openViewer() {
      currentSlideIndex = 0;
      viewer.hidden = false;
      backdrop.hidden = false;
      document.body.style.overflow = 'hidden';
      buildProgressBars(slides.length);
      buildProductCards();
      loadSlide();
      trigger.classList.add('product-story__trigger--viewed');
    }

    function closeViewer() {
      stopCurrentMedia();
      viewer.hidden = true;
      backdrop.hidden = true;
      document.body.style.overflow = '';
    }

    function loadSlide() {
      var slide = slides[currentSlideIndex];
      if (!slide) return;

      for (var i = 0; i < currentSlideIndex; i++) setProgressState(i, 'done');
      for (var j = currentSlideIndex + 1; j < slides.length; j++) setProgressState(j, 'reset');

      stopCurrentMedia();

      if (slide.mediaType === 'video' && slide.video) {
        var video = document.createElement('video');
        video.src = slide.video;
        video.playsInline = true;
        video.muted = isMuted;
        video.autoplay = true;
        if (slide.videoPoster) video.poster = slide.videoPoster;
        video.className = 'stories-viewer__video';
        mediaEl.appendChild(video);
        currentVideoEl = video;
        muteBtn.hidden = false;
        updateMuteIcon();

        video.addEventListener('loadedmetadata', function () {
          animateProgress(currentSlideIndex, video.duration * 1000);
        });
        video.addEventListener('ended', function () {
          if (currentSlideIndex === slides.length - 1) {
            replayBtn.hidden = false;
          } else {
            goToNextSlide();
          }
        });
        video.play().catch(function () {});
      } else if (slide.image) {
        var img = document.createElement('img');
        img.src = slide.image;
        img.alt = slide.heading || '';
        img.className = 'stories-viewer__image';
        mediaEl.appendChild(img);
        muteBtn.hidden = true;
        var durationMs = (slide.duration || 5) * 1000;
        animateProgress(currentSlideIndex, durationMs);
        progressTimer = setTimeout(goToNextSlide, durationMs);
      }

      if (slide.heading) {
        headingEl.textContent = slide.heading;
        headingEl.hidden = false;
      } else {
        headingEl.hidden = true;
      }
    }

    function buildProductCards() {
      productScrollEl.innerHTML = '';
      var cards =
        productData.variants && productData.variants.length
          ? productData.variants
          : [
              {
                id: productData.variantId,
                title: productData.title,
                label: '',
                available: productData.available,
                price: productData.price,
                image: productData.image,
                url: productData.url
              }
            ];

      cards.forEach(function (card) {
        var cardEl = document.createElement('div');
        cardEl.className = 'stories-viewer__product-card';

        var link = document.createElement('a');
        link.className = 'stories-viewer__product-media';
        link.href = card.url || '#';

        var img = document.createElement('img');
        img.className = 'stories-viewer__product-image';
        img.src = card.image || '';
        img.alt = '';
        link.appendChild(img);

        var info = document.createElement('div');
        info.className = 'stories-viewer__product-info';

        var titleEl = document.createElement('span');
        titleEl.className = 'stories-viewer__product-title';
        titleEl.textContent = card.label ? card.title + ' - ' + card.label : card.title;

        var priceEl = document.createElement('span');
        priceEl.className = 'stories-viewer__product-price';
        priceEl.textContent = card.price || productData.price;

        info.appendChild(titleEl);
        info.appendChild(priceEl);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'stories-viewer__add-btn';
        btn.disabled = !card.available || !card.id;
        btn.dataset.variantId = card.id || '';
        var btnLabel = document.createElement('span');
        btnLabel.textContent = card.available ? 'Ajouter au panier' : 'Épuisé';
        btn.appendChild(btnLabel);

        cardEl.appendChild(link);
        cardEl.appendChild(info);
        cardEl.appendChild(btn);
        productScrollEl.appendChild(cardEl);
      });

      productNextBtn.hidden = cards.length < 2;
      productEl.hidden = false;
    }

    function goToNextSlide() {
      if (currentSlideIndex < slides.length - 1) {
        currentSlideIndex++;
        loadSlide();
      } else {
        closeViewer();
      }
    }

    function goToPrevSlide() {
      if (currentSlideIndex > 0) {
        currentSlideIndex--;
        loadSlide();
      }
    }

    function updateMuteIcon() {
      var mutedIcon = muteBtn.querySelector('.stories-icon-muted');
      var unmutedIcon = muteBtn.querySelector('.stories-icon-unmuted');
      mutedIcon.style.display = isMuted ? 'block' : 'none';
      unmutedIcon.style.display = isMuted ? 'none' : 'block';
      muteBtn.setAttribute('aria-pressed', String(!isMuted));
    }

    muteBtn.addEventListener('click', function () {
      isMuted = !isMuted;
      if (currentVideoEl) currentVideoEl.muted = isMuted;
      updateMuteIcon();
    });

    function pauseStory() {
      if (isPaused) return;
      isPaused = true;
      if (currentVideoEl) {
        currentVideoEl.pause();
      } else if (progressTimer) {
        clearTimeout(progressTimer);
        progressTimer = null;
      }
      var segs = progressEl.querySelectorAll('.stories-viewer__progress-fill');
      var activeFill = segs[currentSlideIndex];
      if (activeFill) {
        var computedWidth = getComputedStyle(activeFill).width;
        activeFill.style.transition = 'none';
        activeFill.style.width = computedWidth;
      }
    }

    function resumeStory() {
      if (!isPaused) return;
      isPaused = false;
      if (currentVideoEl) {
        currentVideoEl.play().catch(function () {});
      } else {
        loadSlide();
      }
    }

    trigger.addEventListener('click', openViewer);
    tapPrev.addEventListener('click', goToPrevSlide);
    tapNext.addEventListener('click', goToNextSlide);
    closeBtn.addEventListener('click', closeViewer);
    backdrop.addEventListener('click', closeViewer);

    replayBtn.addEventListener('click', function () {
      replayBtn.hidden = true;
      if (!currentVideoEl) return;
      animateProgress(currentSlideIndex, currentVideoEl.duration * 1000);
      currentVideoEl.currentTime = 0;
      currentVideoEl.play().catch(function () {});
    });

    [tapPrev, tapNext].forEach(function (el) {
      el.addEventListener('pointerdown', pauseStory);
      el.addEventListener('pointerup', resumeStory);
      el.addEventListener('pointerleave', resumeStory);
    });

    document.addEventListener('keydown', function (e) {
      if (viewer.hidden) return;
      if (e.key === 'Escape') closeViewer();
      if (e.key === 'ArrowLeft') goToPrevSlide();
      if (e.key === 'ArrowRight') goToNextSlide();
    });

    productScrollEl.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('.stories-viewer__add-btn') : null;
      if (!btn) return;
      var variantId = btn.dataset.variantId;
      if (!variantId || btn.hasAttribute('data-loading')) return;

      var labelEl = btn.querySelector('span');
      var originalLabel = labelEl.textContent;
      btn.setAttribute('data-loading', '');
      labelEl.textContent = 'Ajout...';

      fetch(cartUrl('cart/add.js'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: [{ id: variantId, quantity: 1 }],
          sections: 'cart-drawer-section',
          sections_url: window.location.pathname
        })
      })
        .then(function (res) {
          if (!res.ok) {
            return res.json().then(function (err) {
              throw new Error((err && err.description) || 'add failed');
            });
          }
          return res.json();
        })
        .then(function (result) {
          labelEl.textContent = 'Ajouté ✓';

          var freshHtml = result.sections && result.sections['cart-drawer-section'];
          if (freshHtml) {
            var wrapper = document.getElementById('shopify-section-cart-drawer-section');
            if (wrapper) {
              var temp = document.createElement('div');
              temp.innerHTML = freshHtml;
              var freshWrapper = temp.querySelector('#shopify-section-cart-drawer-section');
              if (freshWrapper) wrapper.replaceWith(freshWrapper);
            }
          }

          document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true }));
          var drawer = document.getElementById('cart-drawer');
          if (drawer && typeof drawer.open === 'function') {
            try {
              drawer.open();
            } catch (err) {}
          }
        })
        .catch(function (err) {
          console.error('product-story add-to-cart failed', err);
          labelEl.textContent = 'Erreur';
        })
        .finally(function () {
          setTimeout(function () {
            btn.removeAttribute('data-loading');
            labelEl.textContent = originalLabel;
          }, 1500);
        });
    });

    productNextBtn.addEventListener('click', function () {
      var card = productScrollEl.querySelector('.stories-viewer__product-card');
      var cardWidth = card ? card.getBoundingClientRect().width + 10 : 260;
      productScrollEl.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });
  })();
</script>

{% stylesheet %}
  .product-story__trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #14161F;
    color: #FFFFFF;
    border: none;
    border-radius: 999px;
    padding: 10px 18px;
    font-family: var(--font-primary--family, sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .product-story__trigger--bubble {
    flex-direction: column;
    background: none;
    padding: 0;
    gap: 6px;
  }

  .product-story__trigger-label {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb, 20 22 31));
  }

  .product-story__trigger--viewed .stories-bubble__ring {
    background: rgb(var(--color-foreground-rgb, 20 22 31) / 0.25);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story produit",
  "tag": null,
  "blocks": [
    {
      "type": "product-story-slide"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "trigger_style",
      "label": "Apparence du bouton",
      "options": [
        { "value": "button", "label": "Bouton" },
        { "value": "bubble", "label": "Bulle (rond)" }
      ],
      "default": "button"
    },
    {
      "type": "text",
      "id": "trigger_label",
      "label": "Texte du bouton",
      "default": "Voir en story"
    },
    {
      "type": "image_picker",
      "id": "bubble_image",
      "label": "Image de la bulle (si format bulle)",
      "info": "Si vide, utilise l'image principale du produit"
    }
  ],
  "presets": [
    {
      "name": "Story produit",
      "blocks": {
        "slide-1": { "type": "product-story-slide" }
      },
      "block_order": ["slide-1"]
    }
  ]
}
{% endschema %}
