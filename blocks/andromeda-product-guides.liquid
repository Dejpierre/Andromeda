{%- liquid
  assign has_article = false
  if block.settings.article_1 != blank or block.settings.article_2 != blank or block.settings.article_3 != blank
    assign has_article = true
  endif
-%}

{%- if has_article -%}
  <div class="product-guides" {{ block.shopify_attributes }}>
    <p class="product-guides__heading">{{ block.settings.heading | default: 'Pour aller plus loin' }}</p>
    <ul class="product-guides__list">
      {%- for i in (1..3) -%}
        {%- assign key = 'article_' | append: i -%}
        {%- assign a = block.settings[key] -%}
        {%- if a != blank -%}
          <li class="product-guides__item"><a href="{{ a.url }}">{{ a.title }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  <style>
    .product-guides { margin: 16px 0; display: flex; flex-direction: column; gap: 8px; }
    .product-guides__heading { margin: 0; font-size: 14px; font-weight: 500; color: var(--color-foreground); }
    .product-guides__list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .product-guides__item a {
      font-size: 14px;
      color: var(--color-foreground-secondary);
      text-decoration-color: rgb(var(--color-foreground-rgb) / 0.35);
      text-underline-offset: 3px;
    }
    .product-guides__item a:hover { color: var(--color-foreground); }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Guides liés",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pour aller plus loin" },
    { "type": "article", "id": "article_1", "label": "Article 1" },
    { "type": "article", "id": "article_2", "label": "Article 2" },
    { "type": "article", "id": "article_3", "label": "Article 3" }
  ],
  "presets": [
    { "name": "Guides liés", "category": "Produit" }
  ]
}
{% endschema %}
