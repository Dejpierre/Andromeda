{%- liquid
  assign image = block.settings.image
-%}

<div class="afr" id="afr-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="afr__photo-wrap">
    {%- if image -%}
      {{ image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 60vw, 100vw', widths: '400,600,900,1200,1800', class: 'afr__photo', alt: image.alt | default: block.settings.heading }}
    {%- else -%}
      <div class="afr__placeholder" role="img" aria-label="Photo de Marion et Pierre"></div>
    {%- endif -%}
    <div class="afr__overlay" aria-hidden="true"></div>
    <div class="afr__quote" aria-hidden="true">
      <p class="afr__quote-text">« {{ block.settings.quote }} »</p>
      <span class="afr__quote-author">{{ block.settings.quote_author }}</span>
    </div>
    <button type="button" class="afr__toggle" aria-label="{{ block.settings.quote_label | default: 'Afficher la citation des fondateurs' }}" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
  </div>

  <div class="afr__body">
    <h2 class="afr__title">{{ block.settings.heading }}</h2>
    <p class="afr__text">{{ block.settings.text }}</p>
    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}" class="afr__cta">{{ block.settings.link_label }}</a>
    {%- endif -%}
  </div>
</div>

<style>
  .afr {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    padding-inline: 24px;
  }

  .afr__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .afr__title {
    font-family: 'GC Amelie Promised', var(--font-heading--family, Georgia, serif);
    font-size: 28px;
    line-height: 1.15;
    font-weight: 400;
    color: var(--color-foreground);
    margin: 0;
    text-wrap: balance;
  }

  .afr__photo-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
  }

  .afr__photo,
  .afr__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .afr__placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .afr__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 22, 31, 0.82) 0%, rgba(20, 22, 31, 0.5) 55%, rgba(20, 22, 31, 0.25) 100%);
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.33, 1, 0.68, 1);
    pointer-events: none;
  }

  .afr__quote {
    position: absolute;
    left: 20px;
    right: 72px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.33, 1, 0.68, 1), transform 0.6s cubic-bezier(0.33, 1, 0.68, 1);
    pointer-events: none;
  }

  .afr__quote-text {
    font-family: 'GC Amelie Promised', var(--font-heading--family, Georgia, serif);
    font-size: 20px;
    line-height: 1.25;
    color: #FFFFFF;
    margin: 0;
    text-wrap: pretty;
  }

  .afr__quote-author { font-size: 13px; color: #FFFFFF; }

  .afr.is-open .afr__overlay,
  .afr.is-open .afr__quote {
    opacity: 1;
    pointer-events: auto;
  }

  .afr.is-open .afr__quote {
    transform: translateY(0);
    transition-delay: 0.12s;
  }

  .afr__toggle {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-foreground);
  }

  .afr__toggle:focus-visible { outline: 2px solid #4A2731; outline-offset: 2px; }
  .afr__toggle svg { transition: transform 0.4s cubic-bezier(0.33, 1, 0.68, 1); }
  .afr.is-open .afr__toggle svg { transform: rotate(45deg); }

  .afr__text {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-foreground-secondary);
    margin: 0;
    max-width: 440px;
    text-wrap: pretty;
  }

  .afr__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    width: fit-content;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    border-radius: 4px;
    padding: 0 24px;
    text-decoration: none;
    transition: background-color 0.25s ease-out, color 0.25s ease-out;
  }

  .afr__cta:hover { background: var(--color-foreground); color: #FFFFFF; }

  @media screen and (min-width: 750px) {
    .afr {
      flex-direction: row;
      align-items: center;
      gap: 64px;
      padding-inline: 48px;
    }

    .afr__photo-wrap { flex: 1.5; aspect-ratio: 3 / 2; }
    .afr__body { flex: 1; }
    .afr__title { font-size: 36px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .afr * { transition-duration: 0.01ms !important; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('afr-{{ block.id }}');
  if (!root) return;
  var btn = root.querySelector('.afr__toggle');
  var quote = root.querySelector('.afr__quote');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var open = root.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (quote) quote.setAttribute('aria-hidden', open ? 'false' : 'true');
  });
})();
</script>

{% schema %}
{
  "name": "Fondateurs — réassurance",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une soie choisie sans compromis" },
    { "type": "image_picker", "id": "image", "label": "Photo du duo" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Marion et Pierre aiment les beaux objets. Ils ont voulu des accessoires de nuit à la hauteur : soignés dans chaque détail et faits pour durer." },
    { "type": "header", "content": "Citation révélée (bouton +)" },
    { "type": "textarea", "id": "quote", "label": "Citation", "default": "On s'installe confortablement dans son lit et on plonge dans un océan de douceur en mettant son masque en soie." },
    { "type": "text", "id": "quote_author", "label": "Signature", "default": "Marion" },
    { "type": "text", "id": "quote_label", "label": "Libellé accessibilité du bouton", "default": "Afficher la citation des fondateurs" },
    { "type": "header", "content": "Lien" },
    { "type": "text", "id": "link_label", "label": "Texte du bouton", "default": "Qui sommes-nous" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [
    {
      "name": "Fondateurs — réassurance",
      "category": "Produit",
      "settings": {
        "image": "shopify://shop_images/andromeda-fondateurs-duo.jpg",
        "link": "/pages/qui-sommes-nous"
      }
    }
  ]
}
{% endschema %}
