<div class="moona-rituel" id="moona-rituel">

  <div class="moona-rituel__wrap">

    <!-- État : pas de token -->
    <div class="moona-rituel__error moona-anim-3" id="moona-no-token" hidden>
      <div class="moona-rituel__error-icon">✦</div>
      <p>{{ section.settings.no_token_msg | default: 'Scanne le QR code sur ton packaging pour accéder à tes rituels.' }}</p>
    </div>

    <!-- État : token invalide -->
    <div class="moona-rituel__error moona-anim-3" id="moona-invalid" hidden>
      <div class="moona-rituel__error-icon">✦</div>
      <p>{{ section.settings.invalid_msg | default: "Ce lien n'est pas valide ou a expiré. Contacte-nous si tu as besoin d'aide." }}</p>
    </div>

    <!-- Hub sons d'ambiance -->
    <div class="moona-hub" id="moona-hub" data-theme="light">

      <div class="moona-hub__topbar">
        <a href="{{ section.settings.back_url | default: '/' }}" class="moona-hub__icon-btn" aria-label="Retour">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 5 8 12 15 19"></polyline>
          </svg>
        </a>
        {{ settings.logo | image_url: height: 64 | image_tag: alt: 'Andromeda Paris', height: 24, loading: 'lazy', class: 'moona-hub__logo moona-hub__logo--for-light' }}
        {{ settings.logo_inverse | image_url: height: 64 | image_tag: alt: 'Andromeda Paris', height: 24, loading: 'lazy', class: 'moona-hub__logo moona-hub__logo--for-dark' }}
        <button type="button" class="moona-hub__icon-btn" id="moona-hub-theme-btn" aria-label="Passer en version sombre" aria-pressed="false">
          <span id="moona-hub-theme-icon"></span>
        </button>
      </div>

      <div class="moona-hub__heading">
        {%- if section.settings.title != blank -%}
          <h1 class="moona-hub__title">{{ section.settings.title }}</h1>
        {%- endif -%}
        <p class="moona-hub__subtitle" id="moona-hub-subtitle" data-light="{{ section.settings.subtitle | escape }}" data-dark="{{ section.settings.subtitle_dark | escape }}">{{ section.settings.subtitle }}</p>
      </div>

      <div class="moona-hub__collections" id="moona-hub-collections"></div>

      <div class="moona-hub__tracklist">
        <div class="moona-hub__tracklist-header">
          <span class="moona-hub__tracklist-title">Toutes les pistes</span>
          <span class="moona-hub__tracklist-count" id="moona-hub-count"></span>
        </div>
        <div id="moona-hub-tracks"></div>
      </div>

      {%- if section.settings.upcoming_text != blank -%}
        <div class="moona-hub__upcoming">
          <span class="moona-hub__upcoming-title">{{ section.settings.upcoming_title | default: 'À venir' }}</span>
          <span class="moona-hub__upcoming-text">{{ section.settings.upcoming_text }}</span>
        </div>
      {%- endif -%}

    </div>

    <!-- Player immersif -->
    <div class="moona-rituel__player-wrap moona-player2" id="moona-player-wrap" hidden>

      <img class="moona-player2__hero is-active" id="moona-player-hero" alt="">
      <img class="moona-player2__hero" id="moona-player-hero-b" alt="">

      <div class="moona-player2__topbar">
        <button class="moona-player2__icon-btn" id="moona-back-btn" type="button" aria-label="{{ section.settings.back_to_moments | default: 'Choisir un autre rituel' }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 5 8 12 15 19"></polyline>
          </svg>
        </button>
        <span class="moona-player2__logo-pill">
          {{ settings.logo | image_url: height: 36 | image_tag: alt: 'Andromeda Paris', height: 18, loading: 'lazy' }}
        </span>
        <span class="moona-player2__menu-anchor">
          <button class="moona-player2__icon-btn" id="moona-more-btn" type="button" aria-label="Plus d'options" aria-expanded="false" aria-haspopup="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>
            </svg>
          </button>

          <div class="moona-player2__menu" id="moona-more-menu" hidden>
            <button class="moona-player2__menu-item" id="moona-offline-btn" type="button" aria-label="Sauvegarder hors-ligne" hidden>
              <span class="moona-player2__menu-icon moona-offline-icon-dl" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"></path><polyline points="7.5 11 12 15.5 16.5 11"></polyline><line x1="5" y1="20" x2="19" y2="20"></line></svg>
              </span>
              <span class="moona-player2__menu-icon moona-offline-icon-ok" aria-hidden="true" hidden>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12.5 9.5 18 20 6.5"></polyline></svg>
              </span>
              <span class="moona-player2__menu-text">
                <span class="moona-player2__menu-title" id="moona-offline-title">Télécharger ce son</span>
                <span class="moona-player2__menu-hint" id="moona-offline-hint">Écoutez-le sans connexion</span>
              </span>
            </button>

            <span class="moona-player2__menu-sep"></span>

            <button class="moona-player2__menu-item moona-rituel__playlist-btn--active" id="moona-playlist-btn" type="button" aria-label="Mode playlist activé">
              <span class="moona-player2__menu-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="15" y2="6"></line><line x1="4" y1="12" x2="15" y2="12"></line><line x1="4" y1="18" x2="11" y2="18"></line><polyline points="17 15 20 18 17 21"></polyline><path d="M20 18h-5"></path></svg>
              </span>
              <span class="moona-player2__menu-text">
                <span class="moona-player2__menu-title">Mode playlist</span>
                <span class="moona-player2__menu-hint" id="moona-playlist-hint">Enchaîne les sons automatiquement</span>
              </span>
              <span class="moona-player2__switch moona-player2__switch--on" id="moona-playlist-switch" aria-hidden="true">
                <span class="moona-player2__switch-knob"></span>
              </span>
            </button>
          </div>
        </span>
      </div>

      <!-- Orbe visualiseur conservé (utilisé par la logique audio-réactive), non affiché dans ce visuel -->
      <div class="moona-rituel__orb-wrap" aria-hidden="true" hidden>
        <canvas id="moona-orb-canvas" width="560" height="560"></canvas>
      </div>

      <!-- Loader -->
      <div class="moona-player2__loader" id="moona-loader" aria-label="Chargement…" hidden>
        <span></span><span></span><span></span>
      </div>

      <!-- Carte de contrôles -->
      <div class="moona-player2__card-wrap">
        <div class="moona-player2__content" id="moona-player" hidden>
          <span class="moona-player2__moment" id="moona-player-moment" hidden></span>

          <div class="moona-player2__meta">
            <span class="moona-player2__category" id="moona-track-subtitle"></span>
            <h2 class="moona-player2__title" id="moona-track-title"></h2>
          </div>

          <div class="moona-player2__progress-wrap">
            <div class="moona-player2__progress-track" id="moona-track" role="slider" aria-label="Progression" tabindex="0">
              <div class="moona-player2__progress-fill" id="moona-fill"></div>
              <div class="moona-player2__progress-thumb" id="moona-thumb"></div>
            </div>
            <div class="moona-player2__times">
              <span id="moona-current">0:00</span>
              <span id="moona-duration">—</span>
            </div>
          </div>

          <div class="moona-player2__controls">
            <button class="moona-player2__ctrl-btn" id="moona-prev" type="button" aria-label="Piste précédente">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="19 20 9 12 19 4 19 20"></polygon><line x1="5" y1="19" x2="5" y2="5"></line>
              </svg>
            </button>

            <button class="moona-player2__play-btn" id="moona-play-btn" type="button" aria-label="Lecture">
              <svg class="moona-rituel__icon-play" width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="7 4 20 12 7 20 7 4"></polygon>
              </svg>
              <svg class="moona-rituel__icon-pause" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="display:none">
                <line x1="9" y1="5" x2="9" y2="19"></line><line x1="15" y1="5" x2="15" y2="19"></line>
              </svg>
            </button>

            <button class="moona-player2__ctrl-btn" id="moona-next" type="button" aria-label="Piste suivante">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line>
              </svg>
            </button>
          </div>

          <!-- Seek ±15s conservés pour le clavier/media session, non affichés dans ce visuel -->
          <button id="moona-rewind" type="button" aria-label="Reculer 15s" hidden></button>
          <button id="moona-forward" type="button" aria-label="Avancer 15s" hidden></button>

          <div class="moona-player2__sleep-section">
            <div class="moona-player2__sleep-header">
              <span class="moona-player2__sleep-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path></svg>
                Arrêt programmé
              </span>
              <span class="moona-player2__sleep-status" id="moona-sleep-label">Désactivé</span>
            </div>
            <div class="moona-player2__sleep-opts" id="moona-sleep-opts">
              <button class="moona-player2__sleep-opt" data-min="0" type="button">Aucun</button>
              <button class="moona-player2__sleep-opt" data-min="15" type="button">15 min</button>
              <button class="moona-player2__sleep-opt moona-player2__sleep-opt--active" data-min="30" type="button">30 min</button>
              <button class="moona-player2__sleep-opt" data-min="60" type="button">60 min</button>
            </div>
          </div>
        </div>
      </div>

      <audio id="moona-audio" preload="metadata" crossorigin="anonymous"></audio>
    </div>

    {%- if section.settings.show_back_link -%}
      <div class="moona-rituel__footer moona-anim-6">
        <a href="{{ section.settings.back_url | default: '/' }}" class="moona-rituel__shop-link">
          {{ section.settings.back_label | default: '← Retour à la boutique' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  @font-face {
    font-family: 'GC Amelie Promised';
    src: url('https://cdn.shopify.com/s/files/1/1000/9375/5727/files/GC_Amelie_Promised.woff2?v=1786960246') format('woff2');
    font-display: swap;
  }

  @font-face {
    font-family: 'GC Amelie Promised';
    src: url('https://cdn.shopify.com/s/files/1/1000/9375/5727/files/GC_Amelie_Promised.woff2?v=1786960246') format('woff2');
    font-style: normal;
    font-display: swap;
  }

  @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600&display=swap');

  /* ── Keyframes ──────────────────────────────────────── */
  @keyframes moona-fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes moona-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes moona-slide-in {
    from { opacity: 0; transform: translateY(32px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes moona-slide-out {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to   { opacity: 0; transform: translateY(-20px) scale(0.97); }
  }

  @keyframes moona-breathe {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -55%) scale(1); }
    50%       { opacity: 1;   transform: translate(-50%, -55%) scale(1.1); }
  }

  @keyframes moona-stars-twinkle {
    0%, 100% { opacity: 0.5; }
    50%       { opacity: 0.9; }
  }

  @keyframes moona-stars-drift-1 {
    0%, 100% { transform: translate(0, 0); }
    30%       { transform: translate(-10px, -8px); }
    65%       { transform: translate(7px, -13px); }
  }

  @keyframes moona-stars-drift-2 {
    0%, 100% { transform: translate(0, 0); }
    40%       { transform: translate(12px, -7px); }
    70%       { transform: translate(-6px, 10px); }
  }

  @keyframes moona-orb-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(40px, -30px) scale(1.08); }
    66%       { transform: translate(-20px, 20px) scale(0.95); }
  }

  @keyframes moona-orb-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40%       { transform: translate(-50px, 30px) scale(1.1); }
    70%       { transform: translate(30px, -10px) scale(0.92); }
  }

  @keyframes moona-orb-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%       { transform: translate(20px, 40px) scale(1.06); }
  }

  @keyframes moona-orb-4 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    45%       { transform: translate(-35px, -45px) scale(1.08); }
    75%       { transform: translate(28px, 22px) scale(0.94); }
  }

  @keyframes moona-stars-pulse {
    0%, 100% { opacity: 0.55; }
    50%       { opacity: 0.85; }
  }

  @keyframes moona-bounce {
    0%, 80%, 100% { transform: scale(0.5); opacity: 0.3; }
    40%           { transform: scale(1.1); opacity: 1; }
  }


  /* ── Entrance animations ────────────────────────────── */
  .moona-anim-1 { animation: moona-fade-up 0.6s cubic-bezier(.22,1,.36,1) both; animation-delay: 0.05s; }
  .moona-anim-2 { animation: moona-fade-up 0.6s cubic-bezier(.22,1,.36,1) both; animation-delay: 0.18s; }
  .moona-anim-3 { animation: moona-fade-up 0.6s cubic-bezier(.22,1,.36,1) both; animation-delay: 0.32s; }
  .moona-anim-4 { animation: moona-fade-up 0.6s cubic-bezier(.22,1,.36,1) both; animation-delay: 0.44s; }
  .moona-anim-5 { animation: moona-fade-up 0.6s cubic-bezier(.22,1,.36,1) both; animation-delay: 0.56s; }
  .moona-anim-6 { animation: moona-fade-in 0.7s ease both; animation-delay: 0.7s; }

  /* Forcer display:none sur les éléments cachés */
  #moona-rituel [hidden] { display: none !important; animation: none !important; }

  /* Transition states gérées par JS */
  .moona-is-entering {
    animation: moona-slide-in 0.45s cubic-bezier(.22,1,.36,1) both !important;
  }

  .moona-is-leaving {
    animation: moona-slide-out 0.3s ease forwards !important;
    pointer-events: none;
  }

  /* ── Base ───────────────────────────────────────────── */
  .moona-rituel {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px 60px;
    font-family: inherit;
    box-sizing: border-box;
    overflow: hidden;
  }

  .moona-rituel:has(#moona-hub:not([hidden])) {
    padding: 0;
  }

  .moona-rituel:has(#moona-hub[data-theme="dark"]:not([hidden])) {
    background: #14161F;
    transition: background-color 0.25s ease-out;
  }

  .moona-rituel:has(#moona-hub[data-theme="dark"]:not([hidden])) .moona-rituel__bg {
    display: none;
  }

  /* ── Background animé ───────────────────────────────── */
  .moona-rituel__bg {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at 50% 30%, #1E2244 0%, #191A2E 65%);
    z-index: -1;
  }

  .moona-rituel__moon-glow {
    position: absolute;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(210,205,190,0.055) 0%, transparent 70%);
    top: 55%;
    left: 50%;
    transform: translate(-50%, -55%);
    animation: moona-breathe 9s ease-in-out infinite;
    pointer-events: none;
  }

  .moona-rituel__stars,
  .moona-rituel__stars-2 {
    position: absolute;
    inset: -20px;
    pointer-events: none;
  }

  .moona-rituel__stars {
    background-image:
      radial-gradient(1px 1px at 12% 9%,   rgba(255,255,255,0.55) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 27% 5%,  rgba(255,255,255,0.4)  0%, transparent 100%),
      radial-gradient(1px 1px at 44% 14%,  rgba(255,255,255,0.5)  0%, transparent 100%),
      radial-gradient(2px 2px at 63% 6%,   rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(1px 1px at 80% 11%,  rgba(255,255,255,0.5)  0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 92% 20%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 6%  32%,  rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(2px 2px at 19% 40%,  rgba(255,255,255,0.45) 0%, transparent 100%),
      radial-gradient(1px 1px at 36% 28%,  rgba(255,255,255,0.3)  0%, transparent 100%),
      radial-gradient(1px 1px at 51% 22%,  rgba(255,255,255,0.45) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 74% 18%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 85% 30%,  rgba(255,255,255,0.3)  0%, transparent 100%),
      radial-gradient(1px 1px at 8%  50%,  rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(2px 2px at 42% 47%,  rgba(255,255,255,0.25) 0%, transparent 100%),
      radial-gradient(1px 1px at 67% 52%,  rgba(255,255,255,0.4)  0%, transparent 100%);
    animation: moona-stars-twinkle 14s ease-in-out infinite,
               moona-stars-drift-1 22s ease-in-out infinite;
  }

  .moona-rituel__stars-2 {
    background-image:
      radial-gradient(1px 1px at 72% 35%,  rgba(255,255,255,0.4)  0%, transparent 100%),
      radial-gradient(1px 1px at 88% 42%,  rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 4%  62%, rgba(255,255,255,0.45) 0%, transparent 100%),
      radial-gradient(1px 1px at 33% 72%,  rgba(255,255,255,0.3)  0%, transparent 100%),
      radial-gradient(2px 2px at 55% 68%,  rgba(255,255,255,0.4)  0%, transparent 100%),
      radial-gradient(1px 1px at 78% 75%,  rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 94% 60%, rgba(255,255,255,0.45) 0%, transparent 100%),
      radial-gradient(1px 1px at 16% 80%,  rgba(255,255,255,0.3)  0%, transparent 100%),
      radial-gradient(1px 1px at 48% 85%,  rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(2px 2px at 62% 78%,  rgba(255,255,255,0.25) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 82%,  rgba(255,255,255,0.4)  0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 22% 58%, rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(1px 1px at 38% 90%,  rgba(255,255,255,0.3)  0%, transparent 100%),
      radial-gradient(1px 1px at 70% 92%,  rgba(255,255,255,0.25) 0%, transparent 100%),
      radial-gradient(1px 1px at 56% 44%,  rgba(255,255,255,0.3)  0%, transparent 100%);
    animation: moona-stars-twinkle 18s ease-in-out infinite 3s,
               moona-stars-drift-2 30s ease-in-out infinite;
  }


  .moona-rituel__wrap {
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  /* ── Logo ───────────────────────────────────────────── */
  .moona-rituel__logo {
    opacity: 0.85;
  }

  .moona-rituel__logo img {
    height: 40px;
    width: auto;
    display: block;
  }

  .moona-rituel__logo--text {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    text-transform: uppercase;
  }

  /* ── Hub sons d'ambiance (index) ─────────────────────── */
  .moona-hub {
    --hub-bg: #FFFFFF;
    --hub-ink: #14161F;
    --hub-muted: #6E6A63;
    --hub-accent: #B06A47;
    --hub-rule: rgba(20,22,31,0.12);
    --hub-list-rule: rgba(20,22,31,0.12);
    --hub-play-bg: #232A47;
    --hub-play-ink: #FFFFFF;
    --hub-focus: #4A2731;
    width: 100%;
    background: var(--hub-bg);
    padding: calc(88px + env(safe-area-inset-top, 0px)) 16px 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    transition: background-color 0.25s ease-out;
  }

  .moona-hub[data-theme="dark"] {
    --hub-bg: #14161F;
    --hub-ink: #FFFFFF;
    --hub-muted: rgba(255,255,255,0.72);
    --hub-accent: #D79B74;
    --hub-rule: rgba(255,255,255,0.22);
    --hub-list-rule: rgba(255,255,255,0.16);
    --hub-play-bg: #FFFFFF;
    --hub-play-ink: #14161F;
    --hub-focus: #FFFFFF;
  }

  .moona-hub__topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
    background: var(--hub-bg);
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    gap: 12px;
    align-items: center;
    padding: 16px 16px 12px;
    padding-top: calc(16px + env(safe-area-inset-top, 0px));
    transition: background-color 0.25s ease-out;
  }

  .moona-hub__icon-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--hub-rule);
    border-radius: 999px;
    color: var(--hub-ink);
    cursor: pointer;
    text-decoration: none;
    flex-shrink: 0;
    transition: border-color 0.25s ease-out, color 0.25s ease-out;
  }

  .moona-hub__icon-btn:hover {
    border-color: var(--hub-focus);
  }

  .moona-hub__logo {
    display: block;
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    height: 24px;
    width: auto;
  }

  .moona-hub__logo--for-dark {
    display: none;
  }

  .moona-hub[data-theme="dark"] .moona-hub__logo--for-light {
    display: none;
  }

  .moona-hub[data-theme="dark"] .moona-hub__logo--for-dark {
    display: block;
  }

  .moona-hub__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .moona-hub__title {
    font-family: 'GC Amelie Promised', Georgia, serif !important;
    font-weight: 400;
    font-size: 40px;
    line-height: 1.1;
    color: var(--hub-ink);
    margin: 0;
  }

  .moona-hub__subtitle {
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--hub-muted);
    margin: 0;
  }

  .moona-hub__collections {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .moona-hub__collection {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    font-family: inherit;
    color: inherit;
    cursor: pointer;
  }

  .moona-hub__collection-visual {
    position: relative;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--hub-rule);
  }

  .moona-hub__collection-visual img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .moona-hub__collection-play {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border-radius: 999px;
    color: #14161F;
  }

  .moona-hub__collection-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .moona-hub__collection-title {
    font-family: 'GC Amelie Promised', Georgia, serif !important;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.15;
    color: var(--hub-ink);
  }

  .moona-hub__collection-meta {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--hub-muted);
  }

  .moona-hub__tracklist {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .moona-hub__tracklist-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: baseline;
  }

  .moona-hub__tracklist-title {
    font-size: 20px;
    color: var(--hub-ink);
  }

  .moona-hub__tracklist-count {
    font-size: 14px;
    color: var(--hub-muted);
    white-space: nowrap;
  }

  .moona-hub__track {
    width: 100%;
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 10px 0;
    border: none;
    border-bottom: 1px solid var(--hub-list-rule);
    background: none;
    margin: 0;
    text-align: left;
    font-family: inherit;
    color: inherit;
    cursor: pointer;
  }

  .moona-hub__track-thumb {
    width: 56px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    background-color: var(--hub-rule);
  }

  .moona-hub__track-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .moona-hub__track-title {
    font-size: 16px;
    color: var(--hub-ink);
  }

  .moona-hub__track-family {
    font-size: 14px;
    font-weight: 300;
    color: var(--hub-accent);
  }

  .moona-hub__track-play {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--hub-play-bg);
    color: var(--hub-play-ink);
    border-radius: 999px;
    flex-shrink: 0;
    transition: background-color 0.25s ease-out, color 0.25s ease-out;
  }

  .moona-hub__upcoming {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .moona-hub__upcoming-title {
    font-size: 20px;
    color: var(--hub-ink);
  }

  .moona-hub__upcoming-text {
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--hub-muted);
  }

  .moona-hub__icon-btn:focus-visible,
  .moona-hub__collection:focus-visible,
  .moona-hub__track:focus-visible {
    outline: 2px solid var(--hub-focus);
    outline-offset: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .moona-hub,
    .moona-hub__icon-btn,
    .moona-hub__track-play {
      transition: none;
    }
  }

  /* ── Greeting (hérité, non utilisé par le hub) ───────── */
  .moona-rituel__greeting {
    text-align: center;
  }

  .moona-rituel__title {
    font-size: clamp(24px, 5vw, 36px);
    font-family: 'GC Amelie Promised', serif !important;
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 10px;
    line-height: 1.25;
    letter-spacing: 0;
    word-spacing: -0.22em;
  }

  .moona-rituel__subtitle {
    font-size: 15px;
    color: rgba(255,255,255,0.55);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Error states ───────────────────────────────────── */
  .moona-rituel__error {
    text-align: center;
    padding: 32px 24px;
    background: rgba(255,255,255,0.06);
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
    width: 100%;
  }

  .moona-rituel__error-icon {
    font-size: 24px;
    color: #C8B89A;
    margin-bottom: 12px;
  }

  .moona-rituel__error p {
    color: rgba(255,255,255,0.55);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Moment cards ───────────────────────────────────── */
  .moona-rituel__moments {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .moona-rituel__moment {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
    border: none;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    background: transparent;
    text-align: left;
    transition: transform 0.22s cubic-bezier(.34,1.56,.64,1), box-shadow 0.22s ease;
    box-shadow: 0 2px 16px rgba(0,0,0,0.25);
    -webkit-tap-highlight-color: transparent;
  }

  .moona-rituel__moment:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.15);
  }

  .moona-rituel__moment:active {
    transform: scale(0.98);
  }

  .moona-rituel__moment-bg {
    position: absolute;
    inset: 0;
    transition: opacity 0.3s ease;
  }

  .moona-rituel__moment:hover .moona-rituel__moment-bg {
    opacity: 0.85;
  }

  .moona-rituel__moment-bg--sommeil {
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
  }

  .moona-rituel__moment-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    width: 100%;
  }

  .moona-rituel__moment-emoji {
    font-size: 32px;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(.34,1.56,.64,1);
  }

  .moona-rituel__moment:hover .moona-rituel__moment-emoji {
    transform: scale(1.15) rotate(-5deg);
  }

  .moona-rituel__moment-label {
    font-size: 17px;
    font-weight: 500;
    color: #FFFFFF;
    display: block;
    letter-spacing: 0.01em;
  }

  .moona-rituel__moment-desc {
    font-size: 13px;
    color: rgba(255,255,255,0.55);
    display: block;
    margin-top: 3px;
    line-height: 1.4;
  }

  .moona-rituel__moment-inner > div {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* Arrow indicator */
  .moona-rituel__moment-inner::after {
    content: '→';
    color: #C8B89A;
    font-size: 18px;
    margin-left: auto;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .moona-rituel__moment:hover .moona-rituel__moment-inner::after {
    transform: translateX(4px);
  }

  /* ── Folders list ────────────────────────────────────── */
  .moona-rituel__folders-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ── Folder image cards ─────────────────────────────── */
  .moona-rituel__folder-card {
    position: relative;
    width: 100%;
    height: 160px;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1);
    transition: transform 0.22s cubic-bezier(.34,1.56,.64,1), box-shadow 0.22s ease;
    box-shadow: 0 2px 20px rgba(0,0,0,0.35);
    -webkit-tap-highlight-color: transparent;
    background: rgba(255,255,255,0.06);
  }

  .moona-rituel__folder-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }

  .moona-rituel__folder-card:active {
    transform: scale(0.98);
  }

  .moona-rituel__folder-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .moona-rituel__folder-card:hover .moona-rituel__folder-img {
    transform: scale(1.04);
  }

  .moona-rituel__folder-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,8,25,0.85) 0%, rgba(10,8,25,0.25) 55%, rgba(10,8,25,0.1) 100%);
  }

  .moona-rituel__folder-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 20px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .moona-rituel__folder-name {
    font-size: 16px;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: 0.01em;
  }

  .moona-rituel__folder-count {
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.08em;
    flex-shrink: 0;
    margin-left: 12px;
  }

  /* Sans image : fallback glassmorphism */
  .moona-rituel__folder-card--no-img {
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    align-items: center;
    padding: 0 24px;
  }

  .moona-rituel__folder-card--no-img .moona-rituel__folder-info {
    position: static;
    padding: 0;
    width: 100%;
  }

  .moona-rituel__folder-card--no-img .moona-rituel__folder-name {
    font-size: 17px;
  }

  /* ── Tracks view ────────────────────────────────────── */
  .moona-rituel__tracks-view {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .moona-rituel__tracks-header {
    display: flex;
    align-items: center;
  }

  /* ── Player wrap ────────────────────────────────────── */
  .moona-rituel__player-wrap {
    width: 100%;
    background: rgba(255,255,255,0.06);
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(12px);
    padding: 28px 28px 32px;
    box-shadow: 0 4px 32px rgba(0,0,0,0.25);
  }

  .moona-rituel__player-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .moona-rituel__back-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 13px;
    color: rgba(255,255,255,0.4);
    padding: 0;
    transition: color 0.15s, transform 0.2s ease;
  }

  .moona-rituel__back-btn:hover {
    color: #FFFFFF;
    transform: translateX(-3px);
  }

  .moona-rituel__player-moment {
    font-size: 13px;
    color: #C8B89A;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Loader ─────────────────────────────────────────── */
  .moona-rituel__loader {
    display: flex;
    justify-content: center;
    gap: 7px;
    padding: 32px 0;
  }

  .moona-rituel__loader span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FFFFFF;
    animation: moona-bounce 1.2s ease-in-out infinite;
  }

  .moona-rituel__loader span:nth-child(2) { animation-delay: 0.2s; }
  .moona-rituel__loader span:nth-child(3) { animation-delay: 0.4s; }

  /* ── Orbe visualiseur ───────────────────────────────── */
  .moona-rituel__orb-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  #moona-orb-canvas {
    width: 320px;
    height: 320px;
    display: block;
  }

  /* ── Contrôles ─────────────────────────────────────── */
  .moona-rituel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-bottom: 20px;
  }

  .moona-rituel__play-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    transition: transform 0.18s cubic-bezier(.34,1.56,.64,1), background 0.18s ease, box-shadow 0.18s ease;
    flex-shrink: 0;
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
  }

  .moona-rituel__play-btn:hover {
    background: rgba(255,255,255,0.22);
    transform: scale(1.1);
    box-shadow: 0 6px 24px rgba(255,255,255,0.1);
  }

  .moona-rituel__play-btn:active {
    transform: scale(0.95);
  }

  .moona-rituel__seek-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.55);
    transition: background 0.15s, color 0.15s, transform 0.18s cubic-bezier(.34,1.56,.64,1);
    flex-shrink: 0;
  }

  .moona-rituel__seek-btn:hover {
    background: rgba(255,255,255,0.15);
    color: #FFFFFF;
    transform: scale(1.08);
  }

  /* ── Barre de progression ───────────────────────────── */
  .moona-rituel__progress-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .moona-rituel__time {
    font-size: 12px;
    color: rgba(255,255,255,0.4);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    min-width: 32px;
    text-align: center;
  }

  .moona-rituel__progress-track {
    flex: 1;
    height: 4px;
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
    position: relative;
    cursor: pointer;
    outline: none;
    transition: height 0.2s ease;
  }

  .moona-rituel__progress-track:hover {
    height: 6px;
  }

  .moona-rituel__progress-track:focus-visible {
    box-shadow: 0 0 0 3px rgba(255,255,255,0.25);
  }

  .moona-rituel__progress-fill {
    height: 100%;
    background: #C8B89A;
    border-radius: 4px;
    width: 0%;
    pointer-events: none;
    transition: width 0.1s linear;
  }

  .moona-rituel__progress-thumb {
    position: absolute;
    top: 50%;
    left: 0%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 14px;
    background: #FFFFFF;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s, left 0.1s linear, transform 0.15s ease;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }

  .moona-rituel__progress-track:hover .moona-rituel__progress-thumb,
  .moona-rituel__progress-track:focus-visible .moona-rituel__progress-thumb {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.2);
  }

  /* ── Offline button ─────────────────────────────────── */
  .moona-rituel__offline-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: none;
    cursor: pointer;
    color: rgba(255,255,255,0.4);
    transition: background 0.15s, color 0.15s, transform 0.18s ease;
    flex-shrink: 0;
  }

  .moona-rituel__offline-btn:hover {
    background: rgba(255,255,255,0.15);
    color: #FFFFFF;
    transform: scale(1.1);
  }

  .moona-rituel__offline-btn--cached {
    color: #34d399;
    background: rgba(52,211,153,0.12);
  }

  .moona-rituel__offline-btn--loading {
    opacity: 0.5;
    pointer-events: none;
  }

  /* ── Sleep timer ────────────────────────────────────── */
  .moona-rituel__sleep {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .moona-rituel__sleep-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 12px;
    color: rgba(255,255,255,0.3);
    padding: 4px 10px;
    border-radius: 20px;
    transition: background 0.15s, color 0.15s;
  }

  .moona-rituel__sleep-btn:hover {
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.55);
  }

  .moona-rituel__sleep-btn--active {
    color: #C8B89A;
    background: rgba(200,184,154,0.1);
    font-weight: 500;
  }

  .moona-rituel__sleep-opts {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .moona-rituel__sleep-opt {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    color: rgba(255,255,255,0.55);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .moona-rituel__sleep-opt:hover {
    background: rgba(255,255,255,0.12);
    color: #FFFFFF;
    border-color: rgba(255,255,255,0.25);
  }

  /* ── Skip prev/next ────────────────────────────────── */
  .moona-rituel__skip-btn {
    color: rgba(255,255,255,0.35);
  }
  .moona-rituel__skip-btn:disabled {
    opacity: 0.2;
    pointer-events: none;
  }

  /* ── Sleep row & playlist toggle ───────────────────── */
  .moona-rituel__sleep-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .moona-rituel__playlist-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 12px;
    color: rgba(255,255,255,0.3);
    padding: 4px 10px;
    border-radius: 20px;
    transition: background 0.15s, color 0.15s;
  }

  .moona-rituel__playlist-btn:hover {
    background: rgba(255,255,255,0.08);
