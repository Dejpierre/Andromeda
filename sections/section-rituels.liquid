<script>
(function () {
  /* ── DOM ─────────────────────────────────────────────── */
  const rituelRoot    = document.getElementById('moona-rituel');
  const momentsEl     = document.getElementById('moona-moments');
  const playerWrap    = document.getElementById('moona-player-wrap');
  const loaderEl      = document.getElementById('moona-loader');
  const playerEl      = document.getElementById('moona-player');
  const audioEl       = document.getElementById('moona-audio');
  const playBtn       = document.getElementById('moona-play-btn');
  const iconPlay      = playBtn.querySelector('.moona-rituel__icon-play');
  const iconPause     = playBtn.querySelector('.moona-rituel__icon-pause');
  const rewindBtn     = document.getElementById('moona-rewind');
  const forwardBtn    = document.getElementById('moona-forward');
  const backBtn       = document.getElementById('moona-back-btn');
  const momentLabel   = document.getElementById('moona-player-moment');
  const fillEl        = document.getElementById('moona-fill');
  const thumbEl       = document.getElementById('moona-thumb');
  const currentEl     = document.getElementById('moona-current');
  const durationEl    = document.getElementById('moona-duration');
  const track         = document.getElementById('moona-track');
  const offlineBtn    = document.getElementById('moona-offline-btn');
  const offlineIconDl = offlineBtn.querySelector('.moona-offline-icon-dl');
  const offlineIconOk = offlineBtn.querySelector('.moona-offline-icon-ok');
  const sleepLabel    = document.getElementById('moona-sleep-label');
  const sleepOpts     = document.getElementById('moona-sleep-opts');
  const prevBtn       = document.getElementById('moona-prev');
  const nextBtn       = document.getElementById('moona-next');
  const playlistBtn   = document.getElementById('moona-playlist-btn');
  const playlistHint  = document.getElementById('moona-playlist-hint');
  const playlistSwitch = document.getElementById('moona-playlist-switch');
  const offlineTitleEl = document.getElementById('moona-offline-title');
  const offlineHintEl  = document.getElementById('moona-offline-hint');
  let heroActive      = document.getElementById('moona-player-hero');
  let heroStandby     = document.getElementById('moona-player-hero-b');

  function setHeroImage(url, alt) {
    if (!url || url === heroActive.src) {
      if (alt !== undefined) heroActive.alt = alt;
      return;
    }
    heroStandby.onload = () => {
      heroStandby.classList.add('is-active');
      heroActive.classList.remove('is-active');
      const tmp = heroActive;
      heroActive = heroStandby;
      heroStandby = tmp;
    };
    heroStandby.alt = alt || '';
    heroStandby.src = url;
  }
  const trackTitleEl  = document.getElementById('moona-track-title');
  const trackSubEl    = document.getElementById('moona-track-subtitle');
  const moreBtn       = document.getElementById('moona-more-btn');
  const moreMenu      = document.getElementById('moona-more-menu');

  /* ── Helpers animation ───────────────────────────────── */
  function showEl(el) {
    el.hidden = false;
    el.classList.remove('moona-is-leaving');
    el.classList.add('moona-is-entering');
    el.addEventListener('animationend', () => el.classList.remove('moona-is-entering'), { once: true });
  }

  function hideEl(el, cb) {
    const doHide = () => {
      el.classList.remove('moona-is-leaving');
      el.hidden = true;
      if (cb) cb();
    };
    el.classList.add('moona-is-leaving');
    // Fallback si l'animation ne se lance pas (prefers-reduced-motion, etc.)
    const dur = parseFloat(getComputedStyle(el).animationDuration) || 0;
    if (dur === 0) { doHide(); return; }
    el.addEventListener('animationend', doHide, { once: true });
  }

  /* ── Media Session — audio en arrière-plan + contrôles écran verrouillé ── */
  function updateMediaSession(track) {
    if (!('mediaSession' in navigator)) return;
    navigator.mediaSession.metadata = new MediaMetadata({
      title:  track.label  || 'Rituel Andromeda',
      artist: track.desc   || 'Andromeda Paris',
      album:  track.folder || 'Rituels',
      artwork: [
        { src: 'https://cdn.shopify.com/s/files/1/1000/9375/5727/files/logo-blanc-andromeda.png?v=1774981994', sizes: '512x512', type: 'image/png' }
      ]
    });

    navigator.mediaSession.setActionHandler('play',          () => { audioEl.play().catch(() => {}); });
    navigator.mediaSession.setActionHandler('pause',         () => { audioEl.pause(); });
    navigator.mediaSession.setActionHandler('previoustrack', () => { playPrevTrack(); });
    navigator.mediaSession.setActionHandler('nexttrack',     () => { playNextTrack(); });
    navigator.mediaSession.setActionHandler('seekbackward',  () => { audioEl.currentTime = Math.max(0, audioEl.currentTime - 15); });
    navigator.mediaSession.setActionHandler('seekforward',   () => { audioEl.currentTime = Math.min(audioEl.duration || 0, audioEl.currentTime + 15); });
  }

  audioEl.addEventListener('play',  () => { if ('mediaSession' in navigator) navigator.mediaSession.playbackState = 'playing'; });
  audioEl.addEventListener('pause', () => { if ('mediaSession' in navigator) navigator.mediaSession.playbackState = 'paused'; });

  /* ── Métadonnées des dossiers (blocks audio_folder) ─── */
  const folderMeta = {};
  {% for block in section.blocks %}
    {% if block.type == 'audio_folder' %}
    folderMeta[{{ block.settings.folder_name | default: '' | json }}] = {
      image: {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | json }}{% else %}null{% endif %},
      imageAlt: {{ block.settings.image.alt | default: '' | json }},
      shortName: {{ block.settings.short_name | default: '' | json }},
    };
    {% endif %}
  {% endfor %}

  /* ── Données des pistes (blocks audio_track) ─────────── */
  const tracksData = [
    {% for block in section.blocks %}
    {% if block.type == 'audio_track' %}
    {
      folder: {{ block.settings.folder     | default: 'Général'   | json }},
      label:  {{ block.settings.label      | default: 'Audio'     | json }},
      desc:   {{ block.settings.desc       | default: ''          | json }},
      url:    {{ block.settings.audio_url  | default: ''          | json }},
      image:  {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | json }}{% else %}null{% endif %},
    },
    {% endif %}
    {% endfor %}
  ];

  // Grouper par dossier (ordre de premier apparition préservé)
  const folders = {};
  tracksData.forEach(t => {
    if (!folders[t.folder]) folders[t.folder] = [];
    folders[t.folder].push(t);
  });

  /* ── Helpers temps ───────────────────────────────────── */
  function fmtTime(sec) {
    if (!isFinite(sec)) return '—';
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}:${s.toString().padStart(2, '0')}`;
  }

  /* ── Mise à jour de la barre ─────────────────────────── */
  function updateProgress() {
    const pct = audioEl.duration ? (audioEl.currentTime / audioEl.duration) * 100 : 0;
    fillEl.style.width    = pct + '%';
    thumbEl.style.left    = pct + '%';
    currentEl.textContent = fmtTime(audioEl.currentTime);
    durationEl.textContent = isFinite(audioEl.duration)
      ? '-' + fmtTime(audioEl.duration - audioEl.currentTime)
      : '—';
  }

  audioEl.addEventListener('timeupdate', updateProgress);
  audioEl.addEventListener('loadedmetadata', updateProgress);

  audioEl.addEventListener('play', () => {
    iconPlay.style.display  = 'none';
    iconPause.style.display = 'block';
    playerEl.classList.add('is-playing');
  });

  audioEl.addEventListener('pause', () => {
    iconPlay.style.display  = 'block';
    iconPause.style.display = 'none';
    playerEl.classList.remove('is-playing');
  });

  audioEl.addEventListener('ended', () => {
    iconPlay.style.display  = 'block';
    iconPause.style.display = 'none';
    playerEl.classList.remove('is-playing');
    if (playlistMode) {
      playNextTrack();
    } else {
      audioEl.currentTime = 0;
      audioEl.play().catch(() => {});
      startSleepTimer(selectedSleepMinutes);
    }
  });

  /* ── Clic sur la barre ───────────────────────────────── */
  function seekTo(e) {
    const rect = track.getBoundingClientRect();
    const pct  = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    if (audioEl.duration) audioEl.currentTime = pct * audioEl.duration;
  }

  let isDragging = false;
  track.addEventListener('mousedown', e => { isDragging = true; seekTo(e); });
  document.addEventListener('mousemove', e => { if (isDragging) seekTo(e); });
  document.addEventListener('mouseup', () => { isDragging = false; });
  track.addEventListener('touchstart', e => seekTo(e.touches[0]), { passive: true });
  track.addEventListener('touchmove',  e => seekTo(e.touches[0]), { passive: true });

  track.addEventListener('keydown', e => {
    if (!audioEl.duration) return;
    if (e.key === 'ArrowRight') audioEl.currentTime = Math.min(audioEl.duration, audioEl.currentTime + 5);
    if (e.key === 'ArrowLeft')  audioEl.currentTime = Math.max(0, audioEl.currentTime - 5);
  });

  /* ── Boutons lecture ─────────────────────────────────── */
  playBtn.addEventListener('click', () => {
    if (audioEl.paused) audioEl.play().catch(() => {});
    else audioEl.pause();
  });

  rewindBtn.addEventListener('click',  () => { audioEl.currentTime = Math.max(0, audioEl.currentTime - 15); });
  forwardBtn.addEventListener('click', () => { audioEl.currentTime = Math.min(audioEl.duration || 0, audioEl.currentTime + 15); });

  /* ── Éléments du hub ──────────────────────────────────── */
  const hubEl            = document.getElementById('moona-hub');
  const hubCollectionsEl = document.getElementById('moona-hub-collections');
  const hubTracksEl      = document.getElementById('moona-hub-tracks');
  const hubCountEl       = document.getElementById('moona-hub-count');
  const hubThemeBtn      = document.getElementById('moona-hub-theme-btn');
  const hubThemeIconEl   = document.getElementById('moona-hub-theme-icon');
  const hubSubtitleEl    = document.getElementById('moona-hub-subtitle');

  let currentFolder     = null;
  let currentTrack      = null;
  let currentTrackIndex = -1;
  let playlistMode      = true;

  const PLAY_ICON_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="7 4 20 12 7 20 7 4"></polygon></svg>';
  const MOON_ICON_SVG = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path></svg>';
  const SUN_ICON_SVG  = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"></circle><line x1="12" y1="3" x2="12" y2="5"></line><line x1="12" y1="19" x2="12" y2="21"></line><line x1="3" y1="12" x2="5" y2="12"></line><line x1="19" y1="12" x2="21" y2="12"></line><line x1="5.6" y1="5.6" x2="7" y2="7"></line><line x1="17" y1="17" x2="18.4" y2="18.4"></line><line x1="5.6" y1="18.4" x2="7" y2="17"></line><line x1="17" y1="7" x2="18.4" y2="5.6"></line></svg>';

  /* ── Afficher le hub (accueil) ────────────────────────── */
  function showHub() {
    currentFolder            = null;
    hubEl.hidden             = false;
    playerWrap.hidden        = true;
    playerWrap.style.display = 'none';
    rituelRoot.classList.remove('moona-rituel--player-mode');
  }

  function startTrack(track) {
    initOrbAudio();
    currentFolder = track.folder;
    const idx = (folders[track.folder] || []).indexOf(track);
    currentTrackIndex = idx;
    hubEl.hidden = true;
    loadRituel(track, idx);
  }

  function buildHub() {
    const folderNames = Object.keys(folders).slice(0, 2);

    hubCollectionsEl.innerHTML = '';
    folderNames.forEach((name) => {
      const meta = folderMeta[name] || {};
      const list = (folders[name] || []).filter(t => t.url);
      if (!list.length) return;
      const count = `${list.length} son${list.length > 1 ? 's' : ''}`;
      const displayName = meta.shortName || name;

      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'moona-hub__collection';
      card.innerHTML = `
        <span class="moona-hub__collection-visual">
          ${meta.image ? `<img src="${meta.image}" alt="${meta.imageAlt || name}" loading="lazy">` : ''}
          <span class="moona-hub__collection-play" aria-hidden="true">${PLAY_ICON_SVG}</span>
        </span>
        <span class="moona-hub__collection-text">
          <span class="moona-hub__collection-title">${displayName}</span>
          <span class="moona-hub__collection-meta">${count}</span>
        </span>`;
      card.addEventListener('click', () => startTrack(list[0]));
      hubCollectionsEl.appendChild(card);
    });

    const allTracks = tracksData.filter(t => t.url);
    hubCountEl.textContent = `${allTracks.length} son${allTracks.length > 1 ? 's' : ''}`;

    hubTracksEl.innerHTML = '';
    allTracks.forEach((track) => {
      const meta = folderMeta[track.folder] || {};
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'moona-hub__track';
      row.innerHTML = `
        ${meta.image
          ? `<img class="moona-hub__track-thumb" src="${meta.image}" alt="" loading="lazy">`
          : '<span class="moona-hub__track-thumb"></span>'}
        <span class="moona-hub__track-text">
          <span class="moona-hub__track-title">${track.label}</span>
          <span class="moona-hub__track-family">${track.folder}</span>
        </span>
        <span class="moona-hub__track-play" aria-hidden="true">${PLAY_ICON_SVG}</span>`;
      row.addEventListener('click', () => startTrack(track));
      hubTracksEl.appendChild(row);
    });
  }

  /* ── Bascule clair / sombre ───────────────────────────── */
  const HUB_THEME_KEY = 'moona-hub-theme';

  function applyHubTheme(theme, persist) {
    hubEl.dataset.theme = theme;
    const isDark = theme === 'dark';
    hubThemeBtn.setAttribute('aria-pressed', String(isDark));
    hubThemeBtn.setAttribute('aria-label', isDark ? 'Passer en version claire' : 'Passer en version sombre');
    hubThemeIconEl.innerHTML = isDark ? SUN_ICON_SVG : MOON_ICON_SVG;
    if (hubSubtitleEl) {
      hubSubtitleEl.textContent = isDark
        ? (hubSubtitleEl.dataset.dark || hubSubtitleEl.dataset.light)
        : hubSubtitleEl.dataset.light;
    }
    if (persist !== false) {
      try { localStorage.setItem(HUB_THEME_KEY, theme); } catch (e) {}
    }
  }

  function initHubTheme() {
    let theme = null;
    try { theme = localStorage.getItem(HUB_THEME_KEY); } catch (e) {}
    if (theme !== 'light' && theme !== 'dark') {
      theme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
    }
    applyHubTheme(theme, false);
  }

  hubThemeBtn.addEventListener('click', () => {
    applyHubTheme(hubEl.dataset.theme === 'dark' ? 'light' : 'dark');
  });

  /* ── Retour depuis le player ─────────────────────────── */
  backBtn.addEventListener('click', () => {
    audioEl.pause();
    audioEl.src = '';
    clearTimeout(sleepTimerId);
    sleepTimerId = null;
    offlineBtn.hidden = true;
    if (currentBlobUrl) { URL.revokeObjectURL(currentBlobUrl); currentBlobUrl = null; }
    playerWrap.hidden        = true;
    playerWrap.style.display = 'none';
    playerEl.hidden          = true;
    loaderEl.hidden          = true;
    showHub();
  });

  /* ── IndexedDB (cache hors-ligne) ────────────────────── */
  const DB_NAME  = 'moona-offline';
  const DB_STORE = 'audio';

  function openDB() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(DB_NAME, 1);
      req.onupgradeneeded = e => e.target.result.createObjectStore(DB_STORE);
      req.onsuccess = e => resolve(e.target.result);
      req.onerror   = () => reject(req.error);
    });
  }

  async function getCachedBlob(key) {
    try {
      const db = await openDB();
      return await new Promise((resolve, reject) => {
        const req = db.transaction(DB_STORE).objectStore(DB_STORE).get(key);
        req.onsuccess = () => resolve(req.result || null);
        req.onerror   = () => reject(req.error);
      });
    } catch { return null; }
  }

  async function setCachedBlob(key, blob) {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const req = db.transaction(DB_STORE, 'readwrite').objectStore(DB_STORE).put(blob, key);
      req.onsuccess = () => resolve();
      req.onerror   = () => reject(req.error);
    });
  }

  /* ── État hors-ligne ─────────────────────────────────── */
  let currentCacheKey  = null;
  let currentRemoteUrl = null;
  let currentBlobUrl   = null;

  function setOfflineState(state) {
    // state : 'none' | 'available' | 'cached' | 'loading'
    offlineBtn.hidden = (state === 'none');
    offlineBtn.classList.toggle('moona-rituel__offline-btn--cached',  state === 'cached');
    offlineBtn.classList.toggle('moona-rituel__offline-btn--loading', state === 'loading');
    offlineIconDl.hidden = (state === 'cached' || state === 'loading');
    offlineIconOk.hidden = (state !== 'cached');
    const copy = {
      available: { title: 'Télécharger ce son', hint: 'Écoutez-le sans connexion' },
      loading:   { title: 'Téléchargement…', hint: 'Quelques secondes' },
      cached:    { title: 'Disponible hors ligne', hint: "Appuyez pour retirer de l'appareil" },
    }[state] || { title: 'Télécharger ce son', hint: 'Écoutez-le sans connexion' };
    offlineTitleEl.textContent = copy.title;
    offlineHintEl.textContent  = copy.hint;
    offlineBtn.setAttribute('aria-label', copy.title);
  }

  offlineBtn.addEventListener('click', async () => {
    if (offlineBtn.classList.contains('moona-rituel__offline-btn--cached')) return;
    if (!currentRemoteUrl || !currentCacheKey) return;
    setOfflineState('loading');
    try {
      const res  = await fetch(currentRemoteUrl);
      if (!res.ok) throw new Error();
      const blob = await res.blob();
      await setCachedBlob(currentCacheKey, blob);
      setOfflineState('cached');
    } catch {
      setOfflineState('available');
    }
  });

  /* ── Minuterie d'arrêt (fondu de sortie ~25s avant pause) ── */
  let sleepTimerId = null;
  let selectedSleepMinutes = 30;
  const SLEEP_FADE_MS = 25000;

  function applySleepUI(minutes) {
    selectedSleepMinutes = minutes;
    document.querySelectorAll('.moona-player2__sleep-opt').forEach(opt => {
      opt.classList.toggle('moona-player2__sleep-opt--active', parseInt(opt.dataset.min, 10) === minutes);
    });
    sleepLabel.textContent = minutes > 0 ? `Extinction dans ${minutes} min` : 'Désactivé';
    sleepLabel.classList.toggle('moona-player2__sleep-status--active', minutes > 0);
  }

  function fadeOutAndPause() {
    const startVolume = audioEl.volume;
    const steps = 25;
    const stepMs = SLEEP_FADE_MS / steps;
    let i = 0;
    const fadeId = setInterval(() => {
      i++;
      audioEl.volume = Math.max(0, startVolume * (1 - i / steps));
      if (i >= steps) {
        clearInterval(fadeId);
        audioEl.pause();
        audioEl.volume = startVolume;
      }
    }, stepMs);
  }

  function startSleepTimer(minutes) {
    clearTimeout(sleepTimerId);
    sleepTimerId = null;
    applySleepUI(minutes);
    if (minutes > 0) {
      const ms = Math.max(0, minutes * 60 * 1000 - SLEEP_FADE_MS);
      sleepTimerId = setTimeout(fadeOutAndPause, ms);
    }
  }

  document.querySelectorAll('.moona-player2__sleep-opt').forEach(opt => {
    opt.addEventListener('click', () => startSleepTimer(parseInt(opt.dataset.min, 10)));
  });

  document.querySelectorAll('.moona-player2__sleep-opt').forEach(opt => {
    opt.addEventListener('click', () => startSleepTimer(parseInt(opt.dataset.min, 10)));
  });

  /* ── Navigation prev/next ───────────────────────────── */
  function playNextTrack() {
    if (!currentFolder) return;
    const list = folders[currentFolder] || [];
    const next = currentTrackIndex + 1;
    if (next < list.length) {
      currentTrackIndex = next;
      loadRituel(list[next]);
    }
  }

  function playPrevTrack() {
    if (!currentFolder) return;
    const list = folders[currentFolder] || [];
    // Si on est à plus de 3s, recommencer le son courant
    if (audioEl.currentTime > 3) {
      audioEl.currentTime = 0;
      return;
    }
    const prev = currentTrackIndex - 1;
    if (prev >= 0) {
      currentTrackIndex = prev;
      loadRituel(list[prev]);
    }
  }

  function updateSkipButtons() {
    if (!currentFolder) return;
    const list = folders[currentFolder] || [];
    prevBtn.disabled = currentTrackIndex <= 0 && audioEl.currentTime <= 3;
    nextBtn.disabled = currentTrackIndex >= list.length - 1;
  }

  prevBtn.addEventListener('click', () => { initOrbAudio(); playPrevTrack(); });
  nextBtn.addEventListener('click', () => { initOrbAudio(); playNextTrack(); });

  playlistBtn.addEventListener('click', () => {
    playlistMode = !playlistMode;
    playlistBtn.classList.toggle('moona-rituel__playlist-btn--active', playlistMode);
    playlistSwitch.classList.toggle('moona-player2__switch--on', playlistMode);
    playlistHint.textContent = playlistMode ? 'Enchaîne les sons automatiquement' : 'Répète le son en cours';
    playlistBtn.setAttribute('aria-label', playlistMode ? 'Mode playlist activé' : 'Mode son seul activé');
  });

  /* ── Menu "•••" (playlist / hors-ligne) ──────────────── */
  function closeMoreMenu() {
    if (moreMenu.hidden) return;
    moreMenu.hidden = true;
    moreBtn.setAttribute('aria-expanded', 'false');
  }

  moreBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !moreMenu.hidden;
    if (isOpen) {
      closeMoreMenu();
    } else {
      moreMenu.hidden = false;
      moreBtn.setAttribute('aria-expanded', 'true');
    }
  });

  document.addEventListener('click', (e) => {
    if (!moreMenu.hidden && !moreMenu.contains(e.target) && e.target !== moreBtn) {
      closeMoreMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !moreMenu.hidden) {
      closeMoreMenu();
      moreBtn.focus();
    }
  });

  /* ── Charger un rituel (track object) ───────────────── */
  function loadRituel(track, index) {
    currentTrack             = track;
    if (index !== undefined) currentTrackIndex = index;
    hubEl.hidden             = true;
    rituelRoot.classList.add('moona-rituel--player-mode');
    currentCacheKey   = track.label;
    currentRemoteUrl  = track.url || null;
    if (currentBlobUrl) { URL.revokeObjectURL(currentBlobUrl); currentBlobUrl = null; }

    momentLabel.textContent = track.label;
    trackTitleEl.textContent = track.label;
    trackSubEl.textContent   = currentFolder || '';
    const heroMeta = folderMeta[currentFolder] || {};
    const heroImageUrl = track.image || heroMeta.image;
    const heroAlt = track.label ? `Ambiance ${currentFolder || ''} — ${track.label}` : '';
    setHeroImage(heroImageUrl, heroAlt);
    startSleepTimer(selectedSleepMinutes);
    fillEl.style.width      = '0%';
    thumbEl.style.left      = '0%';
    currentEl.textContent   = '0:00';
    durationEl.textContent  = '—';

    if (currentRemoteUrl) {
      audioEl.src = currentRemoteUrl;
      setOfflineState('available');
    } else {
      setOfflineState('none');
    }

    loaderEl.hidden          = true;
    loaderEl.style.display   = 'none';
    playerEl.hidden          = false;
    playerEl.style.display   = 'block';
    playerWrap.hidden        = false;
    playerWrap.style.display = 'block';

    if (currentRemoteUrl) { audioEl.play().catch(() => {}); }
    updateMediaSession(track);
    updateSkipButtons();
  }

  function initOrbAudio() {}

  /* ── Orbe draw loop ──────────────────────────────────── */
  let orbAnalyser = null;
  const orbCanvas = document.getElementById('moona-orb-canvas');
  const orbCx     = orbCanvas.getContext('2d');
  const OW = orbCanvas.width, OH = orbCanvas.height, OCX = OW / 2, OCY = OH / 2;
  const ORB_R = 170, NUM_RINGS = 6, PPR = 60;

  const orbRings = [];
  for (let r = 0; r < NUM_RINGS; r++) {
    const rad   = ORB_R * (0.35 + 0.65 * (r / (NUM_RINGS - 1)));
    const count = Math.round(PPR * (0.4 + 0.6 * (r / (NUM_RINGS - 1))));
    const ps = [];
    for (let i = 0; i < count; i++) {
      ps.push({
        baseAngle:  (i / count) * Math.PI * 2,
        tilt:       (r / NUM_RINGS) * 0.7 + 0.1,
        driftSpeed: (Math.random() - 0.5) * 0.003,
      });
    }
    orbRings.push({ rad, particles: ps, rotSpeed: 0.0003 + r * 0.0001 });
  }

  let orbIdleT = 0, orbGlobalAngle = 0, orbPlayScale = 1.0, orbSpeed = 0.0004;

  function drawOrb() {
    requestAnimationFrame(drawOrb);
    const playing = !audioEl.paused;
    let freqData = null, amp = 0, bass = 0;

    if (orbAnalyser) {
      freqData = new Uint8Array(orbAnalyser.frequencyBinCount);
      orbAnalyser.getByteFrequencyData(freqData);
      let sum = 0;
      for (let i = 0; i < freqData.length; i++) sum += freqData[i];
      amp = sum / (freqData.length * 255);
      const end = Math.floor(freqData.length * 0.1);
      let bs = 0;
      for (let i = 0; i < end; i++) bs += freqData[i];
      bass = bs / (end * 255);
    }

    orbIdleT += 0.012;
    // Lerp vitesse : très lent en pause, modéré en play
    orbSpeed += ((playing ? 0.003 : 0.0004) - orbSpeed) * 0.018;
    orbGlobalAngle += orbSpeed + amp * 0.008;

    // Lerp smooth entre idle (1.0) et playing (1.3)
    orbPlayScale += ((playing ? 1.3 : 1.0) - orbPlayScale) * 0.025;

    orbCx.clearRect(0, 0, OW, OH);

    const breathe  = playing ? 0 : Math.sin(orbIdleT) * 0.04;
    const orbScale = orbPlayScale + breathe + bass * 0.1;
    const pulseR   = ORB_R * orbScale;

    // Lueur dorée
    const glowR  = pulseR * 1.35 + amp * 40;
    const glowA  = playing ? 0.06 + amp * 0.14 : 0.04;
    const grd = orbCx.createRadialGradient(OCX, OCY, 0, OCX, OCY, glowR);
    grd.addColorStop(0,   `rgba(200,184,154,${glowA * 1.5})`);
    grd.addColorStop(0.5, `rgba(200,184,154,${glowA})`);
    grd.addColorStop(1,   'rgba(200,184,154,0)');
    orbCx.fillStyle = grd;
    orbCx.beginPath();
    orbCx.arc(OCX, OCY, glowR, 0, Math.PI * 2);
    orbCx.fill();

    // Anneaux de particules
    for (let ri = 0; ri < NUM_RINGS; ri++) {
      const ring    = orbRings[ri];
      const ringRad = ring.rad * orbScale;
      let ringAmp   = 0;
      if (freqData) {
        const b0 = Math.floor((ri / NUM_RINGS) * freqData.length * 0.5);
        const b1 = Math.floor(((ri + 1) / NUM_RINGS) * freqData.length * 0.5);
        if (b1 > b0) {
          let rs = 0;
          for (let b = b0; b < b1; b++) rs += freqData[b];
          ringAmp = rs / ((b1 - b0) * 255);
        }
      }
      const ringPhase = orbGlobalAngle * ring.rotSpeed * 1000 + ri * 0.5;
      for (const p of ring.particles) {
        const angle = p.baseAngle + ringPhase + p.driftSpeed * orbIdleT * 80;
        const x3 = Math.cos(angle) * ringRad;
        const y3 = Math.sin(angle) * ringRad * Math.cos(p.tilt);
        const z3 = Math.sin(angle) * ringRad * Math.sin(p.tilt);
        const depthNorm = (z3 + ORB_R) / (2 * ORB_R);
        const alpha     = Math.min(1, 0.15 + depthNorm * 0.7 + (playing ? ringAmp * 0.5 : 0));
        const dotSize   = (0.8 + depthNorm * 1.2) * (1 + ringAmp * 1.4);
        orbCx.fillStyle = `rgba(255,255,255,${alpha})`;
        orbCx.beginPath();
        orbCx.arc(OCX + x3, OCY + y3, dotSize, 0, Math.PI * 2);
        orbCx.fill();
      }
    }

    // Point central
    const centA = 0.15 + (playing ? amp * 0.7 : Math.abs(Math.sin(orbIdleT)) * 0.1);
    orbCx.fillStyle = `rgba(255,255,255,${centA})`;
    orbCx.beginPath();
    orbCx.arc(OCX, OCY, 3 + bass * 12, 0, Math.PI * 2);
    orbCx.fill();

    // Anneau extérieur
    orbCx.strokeStyle = `rgba(255,255,255,${0.04 + bass * 0.1})`;
    orbCx.lineWidth   = 0.5;
    orbCx.beginPath();
    orbCx.arc(OCX, OCY, pulseR * 1.05 + bass * 18, 0, Math.PI * 2);
    orbCx.stroke();
  }

  /* ── Init ────────────────────────────────────────────── */
  buildHub();
  initHubTheme();
  showHub();
  drawOrb();
})();
</script>

