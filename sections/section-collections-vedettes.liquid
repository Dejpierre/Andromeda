{% doc %}
  Vitrine de collections vedettes + tuile promo, avec effet de survol
  (deuxième photo ou vidéo) sur chaque tuile collection.

  Chaque bloc "collection" pointe vers une collection Shopify : image,
  titre et prix par défaut viennent de la collection / de son premier
  produit, mais peuvent être surchargés. Le bloc "promo" ajoute une tuile
  image + CTA à la suite des tuiles collection.
{% enddoc %}

{% liquid
  assign image_ratio = section.settings.image_ratio | default: '4 / 5'
  assign tile_count = section.blocks.size | at_least: 1
%}

<div class="collections-showcase color-{{ section.settings.color_scheme }} section-{{ section.settings.section_width }}">
  {% if section.settings.heading != blank %}
    <h2 class="collections-showcase__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div
    class="collections-showcase__grid"
    style="--collections-showcase-ratio: {{ image_ratio }}; --collections-showcase-columns: {{ tile_count }};"
  >
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'collection' %}
          {% liquid
            assign coll = block.settings.collection
            assign first_product = coll.products.first
            assign display_title = block.settings.custom_title | default: coll.title
            assign display_image = block.settings.image | default: coll.featured_image | default: first_product.featured_image
          %}
          <a
            href="{{ coll.url | default: '#' }}"
            class="collections-showcase__tile"
            {{ block.shopify_attributes }}
          >
            <span class="collections-showcase__media">
              {% if display_image != blank %}
                {{
                  display_image
                  | image_url: width: 700
                  | image_tag: class: 'collections-showcase__image collections-showcase__image--base', loading: 'lazy', alt: display_title
                }}
              {% endif %}

              {% if block.settings.hover_video != blank %}
                <video
                  class="collections-showcase__image collections-showcase__image--hover collections-showcase__video"
                  muted
                  loop
                  playsinline
                  preload="none"
                >
                  {% for source in block.settings.hover_video.sources %}
                    <source
                      src="{{ source.url }}"
                      type="{{ source.mime_type }}"
                    >
                  {% endfor %}
                </video>
              {% elsif block.settings.hover_image != blank %}
                {{
                  block.settings.hover_image
                  | image_url: width: 700
                  | image_tag: class: 'collections-showcase__image collections-showcase__image--hover', loading: 'lazy', alt: display_title
                }}
              {% endif %}
            </span>

            <span class="collections-showcase__info">
              <span class="collections-showcase__title">{{ display_title }}</span>
              {% if block.settings.tagline != blank %}
                <span class="collections-showcase__tagline">{{ block.settings.tagline }}</span>
              {% endif %}
              {% if block.settings.show_price and first_product != blank %}
                <span class="collections-showcase__price">
                  {% render 'price', product_resource: first_product %}
                </span>
              {% endif %}
            </span>
          </a>

        {% when 'promo' %}
          <a
            href="{{ block.settings.button_link | default: '#' }}"
            class="collections-showcase__tile collections-showcase__tile--promo"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag: class: 'collections-showcase__image collections-showcase__promo-image', loading: 'lazy', alt: block.settings.title
              }}
            {% endif %}
            <span class="collections-showcase__promo-content">
              {% if block.settings.title != blank %}
                <span class="collections-showcase__promo-badge">{{ block.settings.title }}</span>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <span class="collections-showcase__promo-cta">{{ block.settings.button_label }}</span>
              {% endif %}
            </span>
          </a>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  @font-face {
    font-family: 'GC Amelie Promised';
    src: url('https://cdn.shopify.com/s/files/1/1000/9375/5727/files/GC_Amelie_Promised.woff2?v=1786960246') format('woff2');
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'GC Amelie Promised';
    src: url('https://cdn.shopify.com/s/files/1/1000/9375/5727/files/GC_Amelie_Promised_Italic.woff2?v=1786960246') format('woff2');
    font-style: italic;
    font-display: swap;
  }

  .collections-showcase {
    padding-block: var(--padding-2xl);
  }

  .collections-showcase__heading {
    margin: 0 0 var(--margin-lg);
    text-align: center;
  }

  .collections-showcase__grid {
    display: flex;
    gap: var(--gap-lg);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;

    /* On wide viewports, switch to a grid that always divides the
       available width — a flex row with a fixed tile min-width can
       overflow the section and get clipped by an ancestor. */
    @media screen and (min-width: 750px) {
      display: grid;
      grid-template-columns: repeat(var(--collections-showcase-columns, 4), minmax(0, 1fr));
      overflow-x: visible;
    }
  }

  .collections-showcase__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1 1 220px;
    min-width: 220px;
    scroll-snap-align: start;
    text-decoration: none;
    color: var(--color-foreground);

    @media screen and (min-width: 750px) {
      min-width: 0;
    }
  }

  .collections-showcase__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--collections-showcase-ratio, 4 / 5);
    overflow: hidden;
    border-radius: var(--style-border-radius-lg);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
  }

  .collections-showcase__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collections-showcase__image--base {
    opacity: 1;
    transition: opacity var(--animation-speed-slow) var(--animation-easing);
  }

  .collections-showcase__image--hover {
    opacity: 0;
    transition: opacity var(--animation-speed-slow) var(--animation-easing);
  }

  .collections-showcase__tile:focus-visible .collections-showcase__image--base {
    opacity: 0;
  }

  .collections-showcase__tile:focus-visible .collections-showcase__image--hover {
    opacity: 1;
  }

  /* Swap-on-hover only where a real pointer/mouse is available — on touch
     devices :hover sticks after a tap, so the image swap never reverts. */
  @media (hover: hover) and (pointer: fine) {
    .collections-showcase__tile:hover .collections-showcase__image--base {
      opacity: 0;
    }

    .collections-showcase__tile:hover .collections-showcase__image--hover {
      opacity: 1;
    }
  }

  .collections-showcase__info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
    margin-top: var(--margin-sm);
  }

  .collections-showcase__title {
    font-family: 'GC Amelie Promised', var(--font-heading--family);
    font-style: italic;
    font-size: var(--font-size--lg);
    color: var(--color-foreground);
  }

  .collections-showcase__tagline {
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .collections-showcase__price {
    font-family: 'GC Amelie Promised', var(--font-heading--family);
    font-size: var(--font-size--sm);
    color: var(--color-foreground);
  }

  .collections-showcase__tile--promo {
    position: relative;
    justify-content: flex-end;
    border-radius: var(--style-border-radius-lg);
    overflow: hidden;
    /* No fixed aspect-ratio: stretches to the row's full height (image +
       caption of the other tiles) instead of matching just their image. */
    aspect-ratio: var(--collections-showcase-ratio, 4 / 5);

    @media screen and (min-width: 750px) {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .collections-showcase__promo-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collections-showcase__promo-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-md);
    padding: var(--padding-lg);
  }

  .collections-showcase__promo-badge {
    padding: var(--padding-2xs) var(--padding-sm);
    background-color: rgb(var(--color-background-rgb) / 0.92);
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: var(--font-size--sm);
    border-radius: var(--style-border-radius-buttons-primary);
  }

  .collections-showcase__promo-cta {
    padding: var(--padding-sm) var(--padding-lg);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: var(--font-size--sm);
    text-align: center;
    border-radius: var(--style-border-radius-buttons-primary);
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .collections-showcase__tile--promo:hover .collections-showcase__promo-cta {
    opacity: 0.85;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    // Matches the CSS hover gate: only real pointer/mouse devices get the
    // swap-on-hover video, so it never fires on a mobile tap.
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    document.querySelectorAll('.collections-showcase__tile').forEach(function (tile) {
      var video = tile.querySelector('.collections-showcase__video');
      if (!video) return;

      var play = function () {
        video.currentTime = 0;
        video.play().catch(function () {});
      };
      var stop = function () {
        video.pause();
      };

      tile.addEventListener('mouseenter', play);
      tile.addEventListener('mouseleave', stop);
      tile.addEventListener('focus', play);
      tile.addEventListener('blur', stop);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Collections vedettes",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre (optionnel)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Format des images",
      "options": [
        { "value": "1 / 1", "label": "Carré" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Portrait large" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Largeur de section",
      "options": [
        { "value": "page-width", "label": "Largeur de page" },
        { "value": "full-width", "label": "Pleine largeur" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Titre personnalisé",
          "info": "Laisser vide pour utiliser le titre de la collection."
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Accroche",
          "info": "Ex : \"Classique mais efficace !\""
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Afficher le prix",
          "default": true
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Laisser vide pour utiliser l'image de la collection ou du premier produit."
        },
        {
          "type": "header",
          "content": "Effet au survol"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Deuxième photo au survol",
          "info": "Ignorée si une vidéo est renseignée ci-dessous."
        },
        {
          "type": "video",
          "id": "hover_video",
          "label": "Vidéo au survol"
        }
      ]
    },
    {
      "type": "promo",
      "name": "Tuile promo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre (badge)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texte du bouton",
          "default": "Découvrir"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Lien du bouton"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections vedettes",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "promo" }
      ]
    }
  ]
}
{% endschema %}
