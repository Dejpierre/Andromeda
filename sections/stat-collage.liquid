{%- comment -%}
  Section : Chiffre clé en collage
  Chemin  : sections/stat-collage.liquid

  Un chiffre centré, entouré d'éléments flottants positionnés librement
  (images ou petites cartes). Positions en % du conteneur, réglables
  dans l'éditeur de thème.

  Hooks d'animation : data-collage-stage / data-collage-item / data-collage-center
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign stage_id = 'collage-' | append: section.id
-%}

<style>
  #{{ stage_id }} {
    --collage-bg: {{ s.bg_color }};
    --collage-fg: {{ s.text_color }};
    --collage-stage-h: {{ s.stage_height }}px;
    --collage-value-size: {{ s.value_size }}px;
    --collage-pad-top: {{ s.padding_top }}px;
    --collage-pad-bottom: {{ s.padding_bottom }}px;

    background: var(--collage-bg);
    color: var(--collage-fg);
    padding-top: var(--collage-pad-top);
    padding-bottom: var(--collage-pad-bottom);
  }

  #{{ stage_id }} .collage__stage {
    position: relative;
    max-width: {{ s.max_width }}px;
    margin-inline: auto;
    padding-inline: 20px;
    min-height: var(--collage-stage-h);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ stage_id }} .collage__center {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 20ch;
  }

  #{{ stage_id }} .collage__value {
    margin: 0;
    font-size: var(--collage-value-size);
    line-height: 0.95;
    font-weight: {{ s.value_weight }};
    letter-spacing: -0.02em;
  }

  #{{ stage_id }} .collage__label {
    margin: 0.15em 0 0;
    font-size: calc(var(--collage-value-size) * 0.32);
    line-height: 1.25;
    font-weight: {{ s.label_weight }};
    text-wrap: balance;
  }

  /* --- Éléments flottants --- */
  #{{ stage_id }} .collage__item {
    position: absolute;
    top: var(--top);
    left: var(--left);
    width: var(--w);
    transform: translate(-50%, -50%) rotate(var(--rot));
    z-index: 1;
  }

  #{{ stage_id }} .collage__item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  #{{ stage_id }} .collage__item--shadow > * {
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.28);
  }

  /* --- Carte texte --- */
  #{{ stage_id }} .collage__note {
    background: {{ s.note_bg }};
    color: {{ s.note_fg }};
    border-radius: var(--radius);
    padding: 14px 16px;
    display: grid;
    gap: 8px;
    font-size: 13px;
    line-height: 1.35;
  }

  #{{ stage_id }} .collage__note-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  #{{ stage_id }} .collage__note-head img {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    flex: none;
  }

  #{{ stage_id }} .collage__note-body > * {
    margin: 0;
  }

  #{{ stage_id }} .collage__note-body p + p {
    margin-top: 4px;
  }

  /* --- Mobile : le collage se replie en grille --- */
  @media screen and (max-width: 749px) {
    #{{ stage_id }} .collage__stage {
      display: block;
      min-height: 0;
    }

    #{{ stage_id }} .collage__center {
      max-width: none;
      margin-bottom: 32px;
    }

    #{{ stage_id }} .collage__value {
      font-size: calc(var(--collage-value-size) * 0.55);
    }

    #{{ stage_id }} .collage__label {
      font-size: calc(var(--collage-value-size) * 0.19);
    }

    #{{ stage_id }} .collage__items {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      align-items: start;
    }

    #{{ stage_id }} .collage__item {
      position: static;
      width: auto;
      transform: rotate(calc(var(--rot) / 2));
    }

    #{{ stage_id }} .collage__item--hide-mobile {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ stage_id }} * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<section id="{{ stage_id }}" class="collage">
  <div class="collage__stage" data-collage-stage>
    <div class="collage__items">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign radius = b.radius | append: 'px'
        -%}
        <div
          class="collage__item{% if b.shadow %} collage__item--shadow{% endif %}{% if b.hide_mobile %} collage__item--hide-mobile{% endif %}"
          style="--top: {{ b.top }}%; --left: {{ b.left }}%; --w: {{ b.width }}px; --rot: {{ b.rotation }}deg; --radius: {{ radius }};"
          data-collage-item
          {{ block.shopify_attributes }}
        >
          {%- case block.type -%}
            {%- when 'image' -%}
              {%- if b.image -%}
                {{
                  b.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 45vw, 400px',
                    widths: '200, 400, 600, 800',
                    alt: b.image.alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'collage__placeholder' }}
              {%- endif -%}

            {%- when 'note' -%}
              <div class="collage__note">
                {%- if b.title != blank -%}
                  <div class="collage__note-head">
                    {%- if b.icon -%}
                      {{ b.icon | image_url: width: 72 | image_tag: loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    <span>{{ b.title | escape }}</span>
                  </div>
                {%- endif -%}
                {%- if b.body != blank -%}
                  <div class="collage__note-body">{{ b.body }}</div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="collage__center" data-collage-center>
      {%- if s.value != blank -%}
        <p class="collage__value">{{ s.value | escape }}</p>
      {%- endif -%}
      {%- if s.label != blank -%}
        <p class="collage__label">{{ s.label | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chiffre en collage",
  "tag": "section",
  "class": "section-stat-collage",
  "settings": [
    { "type": "text", "id": "value", "label": "Chiffre", "default": "98%" },
