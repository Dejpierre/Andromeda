{%- liquid
  assign has_any_story = false
  for block in section.blocks
    if block.type == 'story_bubble'
      assign has_any_story = true
    endif
  endfor
-%}

{%- if has_any_story -%}
<div class="stories-section color-{{ section.settings.color_scheme }}" style="--stories-padding-top: {{ section.settings.padding_top }}px; --stories-padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.title != blank -%}
    <h2 class="stories-section__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  <div class="stories-tray stories-tray--{{ section.settings.tray_style | default: 'bubbles' }}" id="stories-tray-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'story_bubble' -%}
        {%- liquid
          assign has_slides = false
          for b2 in section.blocks
            if b2.type == 'story_slide' and b2.settings.group == block.settings.group_name and b2.settings.group != blank
              assign has_slides = true
            endif
          endfor
        -%}
        {%- if has_slides or request.design_mode -%}
          <button
            type="button"
            class="stories-bubble{% unless has_slides %} stories-bubble--empty{% endunless %}"
            data-story-group="{{ block.settings.group_name | escape }}"
            {{ block.shopify_attributes }}
          >
            <span class="stories-bubble__ring">
              <span class="stories-bubble__ring-inner">
                {%- if block.settings.preview_video != blank -%}
                  <video
                    class="stories-bubble__video"
                    autoplay
                    muted
                    loop
                    playsinline
                    {% if block.settings.bubble_image != blank %}poster="{{ block.settings.bubble_image | image_url: width: 160 }}"{% endif %}
                  >
                    <source src="{{ block.settings.preview_video.sources.last.url }}" type="video/mp4">
                  </video>
                {%- elsif block.settings.bubble_image != blank -%}
                  {{
                    block.settings.bubble_image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', class: 'stories-bubble__image', alt: block.settings.label
                  }}
                {%- endif -%}
              </span>
            </span>
            <span class="stories-bubble__label">{{ block.settings.label }}</span>
            {%- unless has_slides -%}
              <span class="stories-bubble__warning" title="Aucun slide associé — ajoutez un bloc &quot;Slide&quot; avec le même identifiant de groupe ({{ block.settings.group_name | escape }})">⚠ Aucun slide</span>
            {%- endunless -%}
          </button>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<div class="stories-viewer__backdrop" id="stories-backdrop-{{ section.id }}" hidden></div>
<div class="stories-viewer" id="stories-viewer-{{ section.id }}" hidden>
  <div class="stories-viewer__progress" id="stories-progress-{{ section.id }}"></div>

  <div class="stories-viewer__header">
    <span class="stories-viewer__title" id="stories-title-{{ section.id }}"></span>
    <div class="stories-viewer__header-actions">
      <button type="button" class="stories-viewer__icon-btn" id="stories-mute-{{ section.id }}" aria-label="Activer le son" aria-pressed="false" hidden>
        <svg class="stories-icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
        <svg class="stories-icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
      </button>
      <button type="button" class="stories-viewer__icon-btn" id="stories-close-{{ section.id }}" aria-label="Fermer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div class="stories-viewer__media" id="stories-media-{{ section.id }}"></div>

  <button type="button" class="stories-viewer__tap stories-viewer__tap--prev" id="stories-tap-prev-{{ section.id }}" aria-label="Précédent"></button>
  <button type="button" class="stories-viewer__tap stories-viewer__tap--next" id="stories-tap-next-{{ section.id }}" aria-label="Suivant"></button>

  <div class="stories-viewer__heading" id="stories-heading-{{ section.id }}" hidden></div>

  <div class="stories-viewer__product" id="stories-product-{{ section.id }}" hidden>
    <div class="stories-viewer__product-scroll" id="stories-product-scroll-{{ section.id }}"></div>
    <button type="button" class="stories-viewer__product-next" id="stories-product-next-{{ section.id }}" aria-label="Voir l'autre variante" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</div>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    var storyMeta = {};
    {%- for block in section.blocks -%}
      {%- if block.type == 'story_bubble' -%}
    storyMeta[{{ block.settings.group_name | json }}] = {
      label: {{ block.settings.label | json }}
    };
      {%- endif -%}
    {%- endfor -%}

    var slidesData = [
      {%- for block in section.blocks -%}
        {%- if block.type == 'story_slide' -%}
      {
        group: {{ block.settings.group | json }},
        mediaType: {{ block.settings.media_type | json }},
        image: {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1600 | json }}{% else %}null{% endif %},
        video: {% if block.settings.video != blank %}{{ block.settings.video.sources.last.url | json }}{% else %}null{% endif %},
        videoPoster: {% if block.settings.video != blank and block.settings.video.preview_image != blank %}{{ block.settings.video.preview_image | image_url: width: 1600 | json }}{% else %}null{% endif %},
        duration: {{ block.settings.duration | default: 5 }},
        heading: {{ block.settings.heading | json }},
        product: {% if block.settings.product != blank %}{
          title: {{ block.settings.product.title | json }},
          price: {{ block.settings.product.price | money | json }},
          image: {% if block.settings.product.featured_image != blank %}{{ block.settings.product.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %},
          url: {{ block.settings.product.url | json }},
          variantId: {% if block.settings.product.selected_or_first_available_variant != blank %}{{ block.settings.product.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
          available: {% if block.settings.product.selected_or_first_available_variant != blank %}{{ block.settings.product.selected_or_first_available_variant.available | json }}{% else %}false{% endif %},
          variants: [
            {%- if block.settings.product.options_with_values.size == 1 -%}
              {%- for val in block.settings.product.options_with_values.first.values -%}
              {
                id: {% if val.variant %}{{ val.variant.id | json }}{% else %}null{% endif %},
                title: {{ block.settings.product.title | json }},
                label: {{ val.name | json }},
                available: {{ val.available | json }},
                price: {% if val.variant %}{{ val.variant.price | money | json }}{% else %}null{% endif %},
                image: {% if val.variant.featured_image != blank %}{{ val.variant.featured_image | image_url: width: 200 | json }}{% elsif block.settings.product.featured_image != blank %}{{ block.settings.product.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %},
                url: {{ block.settings.product.url | json }}
              }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            {%- endif -%}
          ]
        }{% else %}null{% endif %}
      },
        {%- endif -%}
      {%- endfor -%}
    ];

    var groups = {};
    Object.keys(storyMeta).forEach(function (key) {
      groups[key] = [];
    });
    slidesData.forEach(function (s) {
      if (!s.group) return;
      if (!groups[s.group]) groups[s.group] = [];
      groups[s.group].push(s);
    });
    var storyOrder = Object.keys(storyMeta).filter(function (k) {
      return groups[k] && groups[k].length > 0;
    });

    if (!storyOrder.length) return;

    var tray = document.getElementById('stories-tray-' + sectionId);
    var viewer = document.getElementById('stories-viewer-' + sectionId);
    var backdrop = document.getElementById('stories-backdrop-' + sectionId);
    var progressEl = document.getElementById('stories-progress-' + sectionId);
    var titleEl = document.getElementById('stories-title-' + sectionId);
    var mediaEl = document.getElementById('stories-media-' + sectionId);
    var headingEl = document.getElementById('stories-heading-' + sectionId);
    var productEl = document.getElementById('stories-product-' + sectionId);
    var productScrollEl = document.getElementById('stories-product-scroll-' + sectionId);
    var productNextBtn = document.getElementById('stories-product-next-' + sectionId);
    var closeBtn = document.getElementById('stories-close-' + sectionId);
    var muteBtn = document.getElementById('stories-mute-' + sectionId);
    var tapPrev = document.getElementById('stories-tap-prev-' + sectionId);
    var tapNext = document.getElementById('stories-tap-next-' + sectionId);

    var currentStoryIndex = 0;
    var currentSlideIndex = 0;
    var currentVideoEl = null;
    var progressTimer = null;
    var progressStart = 0;
    var progressDuration = 0;
    var progressPausedAt = null;
    var isMuted = true;
    var rafId = null;

    function cartUrl(path) {
      var root = window.Shopify && window.Shopify.routes && window.Shopify.routes.root;
      return (root || '/') + path;
    }

    function buildProgressBars(count) {
      progressEl.innerHTML = '';
      for (var i = 0; i < count; i++) {
        var seg = document.createElement('span');
        seg.className = 'stories-viewer__progress-seg';
        var fill = document.createElement('span');
        fill.className = 'stories-viewer__progress-fill';
        seg.appendChild(fill);
        progressEl.appendChild(seg);
      }
    }

    function setProgressState(index, state) {
      var segs = progressEl.querySelectorAll('.stories-viewer__progress-seg');
      var seg = segs[index];
      if (!seg) return;
      var fill = seg.querySelector('.stories-viewer__progress-fill');
      if (state === 'done') {
        fill.style.transition = 'none';
        fill.style.width = '100%';
      } else if (state === 'reset') {
        fill.style.transition = 'none';
        fill.style.width = '0%';
      }
    }

    function animateProgress(index, durationMs) {
      var segs = progressEl.querySelectorAll('.stories-viewer__progress-seg');
      var seg = segs[index];
      if (!seg) return;
      var fill = seg.querySelector('.stories-viewer__progress-fill');
      fill.style.transition = 'none';
      fill.style.width = '0%';
      // eslint-disable-next-line no-unused-expressions
      fill.offsetHeight;
      fill.style.transition = 'width ' + durationMs + 'ms linear';
      fill.style.width = '100%';
    }

    function clearAutoAdvance() {
      if (progressTimer) {
        clearTimeout(progressTimer);
        progressTimer = null;
      }
    }

    function stopCurrentMedia() {
      clearAutoAdvance();
      if (currentVideoEl) {
        currentVideoEl.pause();
        currentVideoEl = null;
      }
      mediaEl.innerHTML = '';
    }

    var VIEWED_KEY = 'moona-stories-viewed';

    function getViewedStories() {
      try {
        return JSON.parse(localStorage.getItem(VIEWED_KEY)) || {};
      } catch (e) {
        return {};
      }
    }

    function markStoryViewed(storyKey) {
      var viewed = getViewedStories();
      if (viewed[storyKey]) return;
      viewed[storyKey] = true;
      try {
        localStorage.setItem(VIEWED_KEY, JSON.stringify(viewed));
      } catch (e) {}
      var bubble = tray.querySelector('[data-story-group="' + CSS.escape(storyKey) + '"]');
      if (bubble) bubble.classList.add('stories-bubble--viewed');
    }

    function applyViewedState() {
      var viewed = getViewedStories();
      tray.querySelectorAll('.stories-bubble').forEach(function (bubble) {
        if (viewed[bubble.dataset.storyGroup]) {
          bubble.classList.add('stories-bubble--viewed');
        }
      });
    }

    function openViewer(storyKey) {
      var idx = storyOrder.indexOf(storyKey);
      if (idx === -1) return;
      currentStoryIndex = idx;
      currentSlideIndex = 0;
      viewer.hidden = false;
      backdrop.hidden = false;
      document.body.style.overflow = 'hidden';
      markStoryViewed(storyKey);
      loadStory();
    }

    function closeViewer() {
      stopCurrentMedia();
      viewer.hidden = true;
      backdrop.hidden = true;
      document.body.style.overflow = '';
    }

    function loadStory() {
      var key = storyOrder[currentStoryIndex];
      var slides = groups[key];
      titleEl.textContent = storyMeta[key].label || '';
      buildProgressBars(slides.length);
      loadSlide();
    }

    function loadSlide() {
      var key = storyOrder[currentStoryIndex];
      var slides = groups[key];
      var slide = slides[currentSlideIndex];
      if (!slide) return;

      for (var i = 0; i < currentSlideIndex; i++) setProgressState(i, 'done');
      for (var j = currentSlideIndex + 1; j < slides.length; j++) setProgressState(j, 'reset');

      stopCurrentMedia();

      if (slide.mediaType === 'video' && slide.video) {
        var video = document.createElement('video');
        video.src = slide.video;
        video.playsInline = true;
        video.muted = isMuted;
        video.autoplay = true;
        if (slide.videoPoster) video.poster = slide.videoPoster;
        video.className = 'stories-viewer__video';
        mediaEl.appendChild(video);
        currentVideoEl = video;
        muteBtn.hidden = false;
        updateMuteIcon();

        video.addEventListener('loadedmetadata', function () {
          animateProgress(currentSlideIndex, video.duration * 1000);
        });
        video.addEventListener('ended', function () {
          goToNextSlide();
        });
        video.play().catch(function () {});
      } else if (slide.image) {
        var img = document.createElement('img');
        img.src = slide.image;
        img.alt = slide.heading || '';
        img.className = 'stories-viewer__image';
        mediaEl.appendChild(img);
        muteBtn.hidden = true;
        var durationMs = (slide.duration || 5) * 1000;
        animateProgress(currentSlideIndex, durationMs);
        progressTimer = setTimeout(goToNextSlide, durationMs);
      }

      if (slide.heading) {
        headingEl.textContent = slide.heading;
        headingEl.hidden = false;
      } else {
        headingEl.hidden = true;
      }

      if (slide.product) {
        productEl.hidden = false;
        buildProductCards(slide.product);
      } else {
        productEl.hidden = true;
      }
    }

    function buildProductCards(product) {
      productScrollEl.innerHTML = '';
      var cards =
        product.variants && product.variants.length
          ? product.variants
          : [
              {
                id: product.variantId,
                title: product.title,
                label: '',
                available: product.available,
                price: product.price,
                image: product.image,
                url: product.url
              }
            ];

      cards.forEach(function (card) {
        var cardEl = document.createElement('div');
        cardEl.className = 'stories-viewer__product-card';

        var link = document.createElement('a');
        link.className = 'stories-viewer__product-media';
        link.href = card.url || '#';

        var img = document.createElement('img');
        img.className = 'stories-viewer__product-image';
        img.src = card.image || '';
        img.alt = '';
        link.appendChild(img);

        var info = document.createElement('div');
        info.className = 'stories-viewer__product-info';

        var titleEl2 = document.createElement('span');
        titleEl2.className = 'stories-viewer__product-title';
        titleEl2.textContent = card.label ? card.title + ' - ' + card.label : card.title;

        var priceEl = document.createElement('span');
        priceEl.className = 'stories-viewer__product-price';
        priceEl.textContent = card.price || product.price;

        info.appendChild(titleEl2);
        info.appendChild(priceEl);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'stories-viewer__add-btn';
        btn.disabled = !card.available || !card.id;
        btn.dataset.variantId = card.id || '';
        var btnLabel = document.createElement('span');
        btnLabel.textContent = card.available ? 'Ajouter au panier' : 'Épuisé';
        btn.appendChild(btnLabel);

        cardEl.appendChild(link);
        cardEl.appendChild(info);
        cardEl.appendChild(btn);
        productScrollEl.appendChild(cardEl);
      });

      productNextBtn.hidden = cards.length < 2;
    }

    function goToNextSlide() {
      var key = storyOrder[currentStoryIndex];
      var slides = groups[key];
      if (currentSlideIndex < slides.length - 1) {
        currentSlideIndex++;
        loadSlide();
      } else {
        goToNextStory();
      }
    }

    function goToPrevSlide() {
      if (currentSlideIndex > 0) {
        currentSlideIndex--;
        loadSlide();
      } else {
        goToPrevStory();
      }
    }

    function goToNextStory() {
      if (currentStoryIndex < storyOrder.length - 1) {
        currentStoryIndex++;
        currentSlideIndex = 0;
        loadStory();
      } else {
        closeViewer();
      }
    }

    function goToPrevStory() {
      if (currentStoryIndex > 0) {
        currentStoryIndex--;
        currentSlideIndex = 0;
        loadStory();
      }
    }

    function updateMuteIcon() {
      var mutedIcon = muteBtn.querySelector('.stories-icon-muted');
      var unmutedIcon = muteBtn.querySelector('.stories-icon-unmuted');
      mutedIcon.style.display = isMuted ? 'block' : 'none';
      unmutedIcon.style.display = isMuted ? 'none' : 'block';
      muteBtn.setAttribute('aria-pressed', String(!isMuted));
    }

    muteBtn.addEventListener('click', function () {
      isMuted = !isMuted;
      if (currentVideoEl) currentVideoEl.muted = isMuted;
      updateMuteIcon();
    });

    var isPaused = false;
    function pauseStory() {
      if (isPaused) return;
      isPaused = true;
      if (currentVideoEl) {
        currentVideoEl.pause();
      } else if (progressTimer) {
        clearTimeout(progressTimer);
        progressTimer = null;
      }
      var segs = progressEl.querySelectorAll('.stories-viewer__progress-fill');
      var activeFill = segs[currentSlideIndex];
      if (activeFill) {
        var computedWidth = getComputedStyle(activeFill).width;
        activeFill.style.transition = 'none';
        activeFill.style.width = computedWidth;
      }
    }

    function resumeStory() {
      if (!isPaused) return;
      isPaused = false;
      if (currentVideoEl) {
        currentVideoEl.play().catch(function () {});
      } else {
        loadSlide();
      }
    }

    tapPrev.addEventListener('click', goToPrevSlide);
    tapNext.addEventListener('click', goToNextSlide);
    closeBtn.addEventListener('click', closeViewer);
    backdrop.addEventListener('click', closeViewer);

    [tapPrev, tapNext].forEach(function (el) {
      el.addEventListener('pointerdown', pauseStory);
      el.addEventListener('pointerup', resumeStory);
      el.addEventListener('pointerleave', resumeStory);
    });

    document.addEventListener('keydown', function (e) {
      if (viewer.hidden) return;
      if (e.key === 'Escape') closeViewer();
      if (e.key === 'ArrowLeft') goToPrevSlide();
      if (e.key === 'ArrowRight') goToNextSlide();
    });

    var touchStartX = null;
    viewer.addEventListener('touchstart', function (e) {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    viewer.addEventListener('touchend', function (e) {
      if (touchStartX === null) return;
      var delta = e.changedTouches[0].clientX - touchStartX;
      touchStartX = null;
      if (Math.abs(delta) < 60) return;
      if (delta > 0) goToPrevStory();
      else goToNextStory();
    });

    tray.querySelectorAll('.stories-bubble').forEach(function (bubble) {
      bubble.addEventListener('click', function () {
        openViewer(bubble.dataset.storyGroup);
      });
    });

    applyViewedState();

    productScrollEl.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('.stories-viewer__add-btn') : null;
      if (!btn) return;
      var variantId = btn.dataset.variantId;
      if (!variantId || btn.hasAttribute('data-loading')) return;

      var labelEl = btn.querySelector('span');
      var originalLabel = labelEl.textContent;
      btn.setAttribute('data-loading', '');
      labelEl.textContent = 'Ajout...';

      fetch(cartUrl('cart/add.js'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: [{ id: variantId, quantity: 1 }],
          sections: 'cart-drawer-section',
          sections_url: window.location.pathname
        })
      })
        .then(function (res) {
          if (!res.ok) {
            return res.json().then(function (err) {
              throw new Error((err && err.description) || 'add failed');
            });
          }
          return res.json();
        })
        .then(function (result) {
          labelEl.textContent = 'Ajouté ✓';

          var freshHtml = result.sections && result.sections['cart-drawer-section'];
          if (freshHtml) {
            var wrapper = document.getElementById('shopify-section-cart-drawer-section');
            if (wrapper) {
              var temp = document.createElement('div');
              temp.innerHTML = freshHtml;
              var freshWrapper = temp.querySelector('#shopify-section-cart-drawer-section');
              if (freshWrapper) wrapper.replaceWith(freshWrapper);
            }
          }

          document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true }));
          var drawer = document.getElementById('cart-drawer');
          if (drawer && typeof drawer.open === 'function') {
            try {
              drawer.open();
            } catch (err) {}
          }
        })
        .catch(function (err) {
          console.error('stories add-to-cart failed', err);
          labelEl.textContent = 'Erreur';
        })
        .finally(function () {
          setTimeout(function () {
            btn.removeAttribute('data-loading');
            labelEl.textContent = originalLabel;
          }, 1500);
        });
    });

    productNextBtn.addEventListener('click', function () {
      var card = productScrollEl.querySelector('.stories-viewer__product-card');
      var cardWidth = card ? card.getBoundingClientRect().width + 10 : 260;
      productScrollEl.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .stories-section {
    padding-top: var(--stories-padding-top, 24px);
    padding-bottom: var(--stories-padding-bottom, 24px);
  }

  .stories-section__title {
    font-family: var(--font-heading--family, serif);
    font-size: 1.4rem;
    margin: 0 0 16px;
    padding-inline: 16px;
  }

  .stories-tray {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-inline: 16px;
    scrollbar-width: none;
  }

  .stories-tray::-webkit-scrollbar {
    display: none;
  }

  .stories-bubble {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    width: 76px;
    font-family: var(--font-primary--family, sans-serif);
  }

  .stories-bubble__ring {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    padding: 3px;
    background: conic-gradient(from 45deg, #F9CE34, #EE2A7B, #6228D7, #F9CE34);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stories-bubble__ring-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #FFFFFF;
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .stories-bubble__image,
  .stories-bubble__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  .stories-bubble__label {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb, 20 22 31));
    text-align: center;
    line-height: 1.3;
    max-width: 76px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stories-bubble--viewed .stories-bubble__ring {
    background: rgb(var(--color-foreground-rgb, 20 22 31) / 0.25);
  }

  .stories-bubble--empty {
    cursor: default;
  }

  .stories-bubble--empty .stories-bubble__ring {
    background: none;
    border: 2px dashed rgb(var(--color-foreground-rgb, 20 22 31) / 0.3);
  }

  /* Format "Cartes rectangulaires" */
  .stories-tray--rectangle {
    gap: 12px;
  }

  .stories-tray--rectangle .stories-bubble {
    width: 130px;
  }

  .stories-tray--rectangle .stories-bubble__ring {
    width: 130px;
    height: 84px;
    border-radius: 14px;
    padding: 0;
    background: none;
  }

  .stories-tray--rectangle .stories-bubble__ring-inner {
    border-radius: 12px;
    padding: 0;
    box-shadow: 0 4px 14px rgba(20, 22, 31, 0.12);
  }

  .stories-tray--rectangle .stories-bubble__image,
  .stories-tray--rectangle .stories-bubble__video {
    border-radius: 12px;
  }

  .stories-tray--rectangle .stories-bubble__label {
    max-width: 130px;
  }

  .stories-tray--rectangle .stories-bubble--empty .stories-bubble__ring {
    border: 2px dashed rgb(var(--color-foreground-rgb, 20 22 31) / 0.3);
  }

  .stories-tray--rectangle .stories-bubble--viewed .stories-bubble__image,
  .stories-tray--rectangle .stories-bubble--viewed .stories-bubble__video,
  .stories-tray--square .stories-bubble--viewed .stories-bubble__image,
  .stories-tray--square .stories-bubble--viewed .stories-bubble__video {
    opacity: 0.55;
  }

  /* Format "Grandes cartes carrées" */
  .stories-tray--square .stories-bubble {
    width: 140px;
  }

  .stories-tray--square .stories-bubble__ring {
    width: 140px;
    height: 140px;
    border-radius: 18px;
    padding: 0;
    background: none;
  }

  .stories-tray--square .stories-bubble__ring-inner {
    border-radius: 16px;
    padding: 0;
    box-shadow: 0 4px 14px rgba(20, 22, 31, 0.12);
  }

  .stories-tray--square .stories-bubble__image,
  .stories-tray--square .stories-bubble__video {
    border-radius: 16px;
  }

  .stories-tray--square .stories-bubble__label {
    max-width: 140px;
  }

  .stories-tray--square .stories-bubble--empty .stories-bubble__ring {
    border: 2px dashed rgb(var(--color-foreground-rgb, 20 22 31) / 0.3);
  }

  .stories-bubble__warning {
    font-size: 0.65rem;
    color: #B3261E;
    text-align: center;
    max-width: 76px;
    line-height: 1.2;
  }

  .stories-viewer__backdrop {
    position: fixed;
    inset: 0;
    z-index: 999998;
    background: rgba(10, 10, 14, 0.75);
    display: none;
  }

  .stories-viewer {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: #000000;
    display: flex;
    flex-direction: column;
  }

  .stories-viewer[hidden] {
    display: none;
  }

  /* Desktop/tablette : carte flottante type téléphone, avec fond assombri.
     En dessous de 750px : reste plein écran, comme l'expérience Instagram Stories. */
  @media screen and (min-width: 750px) {
    .stories-viewer__backdrop:not([hidden]) {
      display: block;
    }

    .stories-viewer {
      inset: auto;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(420px, 90vw);
      height: min(780px, 90vh);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    }
  }

  .stories-viewer__progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 4px;
    padding: 10px 12px 0;
    z-index: 3;
  }

  .stories-viewer__progress-seg {
    flex: 1;
    height: 2.5px;
    background: rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    overflow: hidden;
  }

  .stories-viewer__progress-fill {
    display: block;
    height: 100%;
    width: 0%;
    background: #FFFFFF;
  }

  .stories-viewer__header {
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 16px;
    z-index: 3;
  }

  .stories-viewer__title {
    color: #FFFFFF;
    font-family: var(--font-primary--family, sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .stories-viewer__header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .stories-viewer__icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    border: none;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .stories-viewer__media {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #14161F;
  }

  .stories-viewer__image,
  .stories-viewer__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stories-viewer__tap {
    position: absolute;
    top: 60px;
    bottom: 130px;
    background: transparent;
    border: none;
    padding: 0;
    z-index: 2;
    cursor: pointer;
  }

  .stories-viewer__tap--prev {
    left: 0;
    width: 30%;
  }

  .stories-viewer__tap--next {
    right: 0;
    width: 70%;
  }

  .stories-viewer__heading {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 148px;
    color: #FFFFFF;
    font-family: var(--font-heading--family, serif);
    font-size: 1.2rem;
    text-align: center;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    z-index: 3;
  }

  .stories-viewer__product {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 3;
  }

  .stories-viewer__product-scroll {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .stories-viewer__product-scroll::-webkit-scrollbar {
    display: none;
  }

  .stories-viewer__product-card {
    flex: 0 0 auto;
    width: 88%;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(30, 30, 34, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 16px;
    padding: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }

  .stories-viewer__product-media {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.1);
  }

  .stories-viewer__product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .stories-viewer__product-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .stories-viewer__product-title {
    font-family: var(--font-primary--family, sans-serif);
    font-size: 0.82rem;
    font-weight: 600;
    color: #FFFFFF;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stories-viewer__product-price {
    font-family: var(--font-primary--family, sans-serif);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .stories-viewer__add-btn {
    flex-shrink: 0;
    background: #14161F;
    color: #FFFFFF;
    border: none;
    border-radius: 999px;
    padding: 9px 14px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }

  .stories-viewer__add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .stories-viewer__product-next {
    position: absolute;
    right: 2px;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    color: #FFFFFF;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 4;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stories produits",
  "blocks": [
    {
      "type": "story_bubble",
      "name": "Bulle (story)",
      "settings": [
        {
          "type": "text",
          "id": "group_name",
          "label": "Identifiant du groupe",
          "info": "Ex: masque — sert à relier les slides à cette bulle"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Titre affiché sous la bulle"
        },
        {
          "type": "image_picker",
          "id": "bubble_image",
          "label": "Image de la bulle"
        },
        {
          "type": "video",
          "id": "preview_video",
          "label": "Aperçu vidéo en boucle (facultatif)",
          "info": "Si renseignée, remplace l'image par un aperçu vidéo muet en boucle sur la vignette, pour donner envie de cliquer"
        }
      ]
    },
    {
      "type": "story_slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "group",
          "label": "Groupe associé",
          "info": "Doit correspondre exactement à l'identifiant d'une bulle"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Type de média",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Vidéo" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (si type image)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Vidéo (si type vidéo)"
        },
        {
          "type": "range",
          "id": "duration",
          "label": "Durée (secondes, image uniquement)",
          "min": 2,
          "max": 15,
          "step": 1,
          "unit": "s",
          "default": 5
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Texte affiché (facultatif)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produit associé"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre de la section (facultatif)"
    },
    {
      "type": "select",
      "id": "tray_style",
      "label": "Format des vignettes",
      "options": [
        { "value": "bubbles", "label": "Bulles (rond)" },
        { "value": "rectangle", "label": "Cartes rectangulaires" },
        { "value": "square", "label": "Grandes cartes carrées" }
      ],
      "default": "bubbles"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Stories produits"
    }
  ]
}
{% endschema %}
