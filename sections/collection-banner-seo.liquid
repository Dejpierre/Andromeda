{%- liquid
  assign banner_image = section.settings.image | default: collection.image
-%}

<div class="cbs" id="cbs-{{ section.id }}">
  <div class="cbs__banner">
    {%- if banner_image -%}
      {%- assign banner_image_alt = banner_image.alt | default: collection.title -%}
      {{ banner_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750,1100,1500,2000,2400', class: 'cbs__img', alt: banner_image_alt }}
    {%- endif -%}
    <div class="cbs__overlay" style="--cbs-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}" aria-hidden="true"></div>

    <div class="cbs__content">
      <div class="cbs__crumb">
        <a href="{{ shop.url }}">Accueil</a>
        <span>›</span>
        <span>{{ collection.title }}</span>
      </div>
      <h1 class="cbs__title">{{ collection.title }}</h1>

      {%- if collection.description != blank -%}
        <div class="cbs__text-wrap">
          <div class="cbs__text rte" id="cbs-text-{{ section.id }}">{{ collection.description }}</div>
        </div>
        <button type="button" class="cbs__toggle" aria-expanded="false" aria-controls="cbs-text-{{ section.id }}">
          <span class="cbs__toggle-label" data-label-more="{{ section.settings.label_more | default: 'Lire la suite' }}" data-label-less="{{ section.settings.label_less | default: 'Réduire' }}">{{ section.settings.label_more | default: 'Lire la suite' }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .cbs__banner {
    position: relative;
    width: 100%;
    min-height: 400px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .cbs__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cbs__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
      rgba(20, 22, 31, calc(var(--cbs-overlay-opacity) * 1.0)) 0%,
      rgba(20, 22, 31, calc(var(--cbs-overlay-opacity) * 0.65)) 60%,
      rgba(20, 22, 31, calc(var(--cbs-overlay-opacity) * 0.3)) 100%
    );
  }

  .cbs__content {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 48px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cbs__crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #FFFFFF;
  }

  .cbs__crumb a { color: #FFFFFF; text-decoration-color: rgba(255,255,255,0.4); text-underline-offset: 3px; }
  .cbs__crumb a:hover { text-decoration-color: #FFFFFF; }
  .cbs__crumb span { opacity: 0.6; }

  .cbs__title {
    font-family: 'GC Amelie Promised', var(--font-heading--family, Georgia, serif);
    font-size: 32px;
    line-height: 1.1;
    font-weight: 400;
    color: #FFFFFF;
    margin: 0;
  }

  .cbs__text-wrap {
    max-width: 100%;
    overflow: hidden;
  }

  .cbs__text {
    max-height: 78px;
    overflow: hidden;
    transition: max-height 0.6s cubic-bezier(0.33, 1, 0.68, 1);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cbs__text p { margin: 0; font-size: 16px; font-weight: 300; line-height: 1.6; color: #FFFFFF; text-wrap: pretty; }
  .cbs__text h2 { margin: 0; font-size: 18px; font-weight: 400; color: #FFFFFF; font-family: 'GC Amelie Promised', var(--font-heading--family, Georgia, serif); }
  .cbs__text a { color: #FFFFFF; text-decoration-color: rgba(255,255,255,0.5); }

  .cbs__toggle {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-family: var(--font-body--family);
    font-size: 14px;
    color: #FFFFFF;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .cbs__toggle-label { text-decoration: underline; text-underline-offset: 4px; }

  .cbs__toggle svg { transition: transform 0.4s cubic-bezier(0.33, 1, 0.68, 1); }

  .cbs__banner.is-open .cbs__toggle svg { transform: rotate(180deg); }

  .cbs__toggle:focus-visible { outline: 2px solid #FFFFFF; outline-offset: 2px; }

  @media screen and (min-width: 750px) {
    .cbs__banner { min-height: 340px; align-items: center; }

    .cbs__overlay {
      background: linear-gradient(to right,
        rgba(20, 22, 31, calc(var(--cbs-overlay-opacity) * 1.0)) 0%,
        rgba(20, 22, 31, calc(var(--cbs-overlay-opacity) * 0.73)) 45%,
        rgba(20, 22, 31, 0) 80%
      );
    }

    .cbs__content { padding: 40px 48px; }
    .cbs__title { font-size: 48px; }
    .cbs__text-wrap { max-width: 520px; }
    .cbs__text { max-height: 52px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cbs__text, .cbs__toggle svg { transition-duration: 0.01ms !important; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('cbs-{{ section.id }}');
  if (!root) return;
  var banner = root.querySelector('.cbs__banner');
  var btn = root.querySelector('.cbs__toggle');
  var text = root.querySelector('.cbs__text');
  if (!btn || !text) return;
  var label = btn.querySelector('.cbs__toggle-label');

  btn.addEventListener('click', function () {
    var open = banner.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    text.style.maxHeight = open ? text.scrollHeight + 'px' : '';
    if (label) label.textContent = open ? label.dataset.labelLess : label.dataset.labelMore;
  });
})();
</script>

{% schema %}
{
  "name": "Bannière SEO collection",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (sinon image de la collection)" },
    { "type": "range", "id": "overlay_opacity", "label": "Opacité du voile", "min": 0, "max": 100, "step": 1, "default": 82 },
    { "type": "text", "id": "label_more", "label": "Libellé \"déplier\"", "default": "Lire la suite" },
    { "type": "text", "id": "label_less", "label": "Libellé \"replier\"", "default": "Réduire" }
  ],
  "presets": [{ "name": "Bannière SEO collection" }]
}
{% endschema %}
