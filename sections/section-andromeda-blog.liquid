{%- doc -%}
  Page hub du blog (liste des articles) — refonte pour cohérence avec le
  nouveau template article éditorial : plus de hero sombre étoilé, même
  système typographique et couleurs (GC Amelie, terracotta #B06A47, dark
  #191A2E) que la page FAQ, le footer et les articles.
{%- enddoc -%}

{% paginate blog.articles by section.settings.articles_per_page %}

<div class="andro-blog" id="andro-blog" style="--ab-accent: #B06A47; --ab-dark: #191A2E; --ab-heading: #14161F; --ab-muted: #6E6A63; --ab-body: #3A3A42;">

  <!-- ── En-tête ───────────────────────────────────────────────────── -->
  <div class="section andro-blog__header">
    <div class="andro-blog__header-inner">
      <p class="andro-blog__eyebrow">{{ section.settings.eyebrow | default: 'Journal' }}</p>
      <h1 class="andro-blog__title">{{ section.settings.heading | default: blog.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="andro-blog__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- ── Grille d'articles ─────────────────────────────────────────── -->
  <div class="section andro-blog__grid-section">
    <div class="andro-blog__grid">
      {%- for article in blog.articles -%}
        <article class="andro-blog__card{% if forloop.first %} andro-blog__card--hero{% endif %}">

          {%- if article.image -%}
            {%- assign img_loading = 'lazy' -%}
            {%- if forloop.index <= 2 -%}
              {%- assign img_loading = 'eager' -%}
            {%- endif -%}
            <a href="{{ article.url }}" class="andro-blog__card-img-wrap" tabindex="-1" aria-hidden="true">
              {{
                article.image
                | image_url: width: 1200
                | image_tag:
                  loading: img_loading,
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '400,600,900,1200',
                  class: 'andro-blog__card-img',
                  alt: article.image.alt | default: article.title
              }}
            </a>
          {%- endif -%}

          <div class="andro-blog__card-body">
            <div class="andro-blog__card-meta">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: '%-d %B %Y' }}
              </time>
              {%- if article.tags.size > 0 -%}
                <span class="andro-blog__card-tag">{{ article.tags.first }}</span>
              {%- endif -%}
            </div>

            <h2 class="andro-blog__card-title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h2>

            {%- if article.excerpt != blank -%}
              <p class="andro-blog__card-excerpt">{{ article.excerpt | strip_html | truncate: 140 }}</p>
            {%- endif -%}

            <a href="{{ article.url }}" class="andro-blog__card-link" aria-label="Lire {{ article.title }}">
              Lire la suite
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>

        </article>
      {%- else -%}
        <p class="andro-blog__empty">Aucun article pour le moment.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="andro-blog__pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="andro-blog__page-btn">← Précédent</a>
        {%- endif -%}
        <span class="andro-blog__page-info">{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="andro-blog__page-btn">Suivant →</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  </div>

</div>

{% endpaginate %}

{% stylesheet %}
  .andro-blog {
    background: #ffffff;
  }

  /* ── En-tête ───────────────────────────────────────────── */
  .andro-blog__header {
    padding-block: 96px 48px;
  }

  .andro-blog__header-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .andro-blog__eyebrow {
    font-size: 14px;
    color: var(--ab-accent);
    margin: 0;
  }

  .andro-blog__title {
    font-family: 'GC Amelie Promised', var(--font-heading--family, serif);
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.1;
    color: var(--ab-heading);
    margin: 0;
    text-wrap: balance;
  }

  .andro-blog__subtitle {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ab-muted);
    margin: 0;
  }

  /* ── Grille ────────────────────────────────────────────── */
  .andro-blog__grid-section {
    padding-block: 0 96px;
  }

  .andro-blog__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .andro-blog__card--hero {
    grid-column: 1 / -1;
  }

  @media screen and (max-width: 749px) {
    .andro-blog__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .andro-blog__card--hero {
      grid-column: 1;
    }
  }

  /* ── Carte ─────────────────────────────────────────────── */
  .andro-blog__card {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(20, 22, 31, 0.12);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color var(--animation-speed-slow, 0.2s) var(--animation-easing, ease-in-out);
  }

  .andro-blog__card:hover {
    border-color: rgba(20, 22, 31, 0.25);
  }

  .andro-blog__card-img-wrap {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .andro-blog__card--hero .andro-blog__card-img-wrap {
    aspect-ratio: 21 / 9;
  }

  .andro-blog__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--animation-easing, ease-in-out);
  }

  .andro-blog__card:hover .andro-blog__card-img {
    transform: scale(1.04);
  }

  /* ── Corps de carte ────────────────────────────────────── */
  .andro-blog__card-body {
    padding: 24px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .andro-blog__card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--ab-muted);
  }

  .andro-blog__card-tag {
    font-size: 12px;
    color: var(--ab-accent);
    background: rgba(176, 106, 71, 0.1);
    border-radius: 2px;
    padding: 3px 8px;
  }

  .andro-blog__card-title {
    font-family: 'GC Amelie Promised', var(--font-heading--family, serif);
    font-size: 24px;
    line-height: 1.2;
    color: var(--ab-heading);
    margin: 0;
  }

  .andro-blog__card--hero .andro-blog__card-title {
    font-size: 32px;
  }

  .andro-blog__card-title a {
    color: inherit;
    text-decoration: none;
  }

  .andro-blog__card:hover .andro-blog__card-title {
    color: var(--ab-accent);
  }

  .andro-blog__card-excerpt {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ab-body);
    margin: 0;
    flex: 1;
  }

  .andro-blog__card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--ab-accent);
    text-decoration: none;
    margin-top: 4px;
    transition: gap var(--animation-speed-slow, 0.2s) var(--animation-easing, ease-in-out);
  }

  .andro-blog__card:hover .andro-blog__card-link {
    gap: 10px;
  }

  /* ── Vide / Pagination ─────────────────────────────────── */
  .andro-blog__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--ab-muted);
    padding: 60px 0;
    font-weight: 300;
  }

  .andro-blog__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding-top: 64px;
  }

  .andro-blog__page-btn {
    font-size: 14px;
    color: var(--ab-heading);
    text-decoration: none;
    border: 1px solid rgba(20, 22, 31, 0.2);
    padding: 12px 24px;
    border-radius: 999px;
    transition: border-color var(--animation-speed-slow, 0.2s) var(--animation-easing, ease-in-out);
  }

  .andro-blog__page-btn:hover {
    border-color: var(--ab-accent);
    color: var(--ab-accent);
  }

  .andro-blog__page-info {
    font-size: 14px;
    color: var(--ab-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Andromeda",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texte au-dessus du titre",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre (laisse vide = nom du blog)"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles par page",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "Blog Andromeda"
    }
  ]
}
{% endschema %}
